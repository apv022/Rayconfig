#!/bin/sh
# gen-theme — render every *.in from a palette. No framework, no deps.
#
#   gen-theme sunset
#   RAY_RENDER_ROOT=/tmp/x gen-theme sunny   # test into a copy
#
# Tokens: @key@ is the current theme, @key_dark@ / @key_light@ are the other
# variants (so the Neovim colorscheme can carry both), @key_hex@ is the value
# without '#', and @theme@ is the theme name.

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
RENDER=${RAY_RENDER_ROOT:-$ROOT}
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig

die() { printf 'gen-theme: %s\n' "$*" >&2; exit 1; }

[ -d "$RENDER/dots" ] || die "no dots/ under $RENDER"
[ -d "$RENDER/themes" ] || die "no themes/ under $RENDER"

theme=${1:-}
if [ -z "$theme" ]; then
	[ -f "$STATE/theme" ] && theme=$(cat "$STATE/theme") || theme=sunset
fi
[ -d "$RENDER/themes/$theme" ] || die "no such theme: $theme"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cur=$tmp/cur
dart=$tmp/dark
lite=$tmp/light
: >"$cur"
: >"$dart"
: >"$lite"

load() { # palette-file suffix outfile
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in '' | '#'*) continue ;; esac
		case $line in *=*) ;; *) die "bad palette line in $1: $line" ;; esac
		k=${line%%=*}
		v=${line#*=}
		[ -n "$k" ] && [ -n "$v" ] || die "bad palette line in $1: $line"
		printf '%s%s=%s\n' "$k" "$2" "$v" >>"$3"
		printf '%s%s_hex=%s\n' "$k" "$2" "$(printf '%s' "$v" | tr -d '#')" >>"$3"
	done <"$1"
}

load "$RENDER/themes/$theme/palette" "" "$cur"
# The editor carries a dark and a light variant: the active theme fills its
# own side, sunset/sunny fill the other.
tvar=$(sed -n 's/^variant=//p' "$RENDER/themes/$theme/palette" | head -n1)
darkp=$RENDER/themes/sunset/palette
lightp=$RENDER/themes/sunny/palette
[ "$tvar" = dark ] && darkp=$RENDER/themes/$theme/palette
[ "$tvar" = light ] && lightp=$RENDER/themes/$theme/palette
load "$darkp" "_dark" "$dart"
load "$lightp" "_light" "$lite"
printf 'theme=%s\n' "$theme" >>"$cur"
# The font is a setting, not a colour, but every template that has a colour
# also names a font, so it rides along. `ray font` changes it.
font=$(sed -n 's/^font=//p' "$STATE/settings" 2>/dev/null | tail -n1)
printf 'font=%s\n' "${font:-JetBrains Mono}" >>"$cur"

# foot 1.26+ renamed [colors] to [colors-dark]/[colors-light]. Pick the section
# that matches the palette's variant instead of hard-coding the old name.
variant=$(sed -n 's/^variant=//p' "$RENDER/themes/$theme/palette" | head -n1)
case $variant in
dark) printf 'colors_section=[colors-dark]\n' >>"$cur" ;;
light) printf 'colors_section=[colors-light]\n' >>"$cur" ;;
*) die "themes/$theme/palette needs variant=dark or variant=light" ;;
esac

# sed script. Escape the delimiter and '&' even though palettes are hex.
sedscript=$tmp/sed
: >"$sedscript"
for f in "$cur" "$dart" "$lite"; do
	while IFS='=' read -r k v; do
		ev=$(printf '%s' "$v" | sed 's/[&|\\]/\\&/g')
		printf 's|@%s@|%s|g\n' "$k" "$ev" >>"$sedscript"
	done <"$f"
done

render() { # src dst
	sed -f "$sedscript" "$1" >"$2.tmp" || {
		rm -f "$2.tmp"
		die "render failed: $1"
	}
	if grep -q '@[A-Za-z_][A-Za-z0-9_]*@' "$2.tmp"; then
		bad=$(grep -o '@[A-Za-z_][A-Za-z0-9_]*@' "$2.tmp" | sort -u | tr '\n' ' ')
		rm -f "$2.tmp"
		die "unresolved tokens in $1: $bad"
	fi
	mv "$2.tmp" "$2"
}

say() { printf '  %s\n' "$*"; }

n=0
find "$RENDER/dots" -type f -name '*.in' | sort >"$tmp/list"
while IFS= read -r src; do
	dst=${src%.in}
	render "$src" "$dst"
	say "${dst#"$RENDER"/}"
	n=$((n + 1))
done <"$tmp/list"
[ "$n" -gt 0 ] || die "no *.in templates found under $RENDER/dots"

# The Neovim colorscheme lives in solarvim's config, outside this repo.
sv="$ROOT/templates/solarvim-ray.lua.in"
if [ -f "$sv" ]; then
	if [ -d "$CFG/solarvim" ] || [ "${RAY_SOLARVIM:-0}" = 1 ]; then
		mkdir -p "$CFG/solarvim/colors"
		render "$sv" "$CFG/solarvim/colors/ray.lua"
		say "solarvim/colors/ray.lua"
	else
		say "solarvim not found; skipping colorscheme (RAY_SOLARVIM=1 to force)"
	fi
fi

# btop reads themes from its own config dir; btop.conf is btop's to rewrite,
# so only the theme file is ours (install.sh points color_theme at it once).
bt="$ROOT/templates/btop-ray.theme.in"
if [ -f "$bt" ] && [ "$RENDER" = "$ROOT" ]; then
	mkdir -p "$CFG/btop/themes"
	render "$bt" "$CFG/btop/themes/ray.theme"
	say "btop/themes/ray.theme"
fi

# State: the active theme name, plus a shell file the utilities source.
mkdir -p "$STATE"
if [ -f "$RENDER/themes/$theme/wallpaper.png" ]; then
	ln -sfn "$RENDER/themes/$theme/wallpaper.png" "$STATE/wallpaper.png"
fi
printf '%s\n' "$theme" >"$STATE/theme"
{
	printf '# generated by gen-theme: %s\n' "$theme"
	while IFS='=' read -r k v; do
		printf "RAY_%s='%s'\n" "$(printf '%s' "$k" | tr '[:lower:]' '[:upper:]')" "$v"
	done <"$cur"
} >"$STATE/theme.sh.tmp"
mv "$STATE/theme.sh.tmp" "$STATE/theme.sh"

printf 'theme: %s\n' "$theme"
