#!/bin/sh
# keys — cheat sheets, generated from the configs themselves. Nothing to keep
# in sync: sway binds are read from 30-binds.conf (## section, # description),
# solarvim's from its own key table, muhfm's from `muhfm --keys`.
#
#   keys              desktop + editor + files
#   keys sway|vim|fm  just one
#   keys --pager    same, in less (what Super+/ opens)
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)
binds=$ROOT/dots/sway/config.d/30-binds.conf

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	H=$(printf '\033[1;38;5;214m'); K=$(printf '\033[38;5;222m'); D=$(printf '\033[38;5;244m'); Z=$(printf '\033[0m')
else H='' K='' D='' Z=''; fi

sway_sheet() {
	printf '%s☀ DESKTOP%s  %s(Super = the Windows key)%s\n' "$H" "$Z" "$D" "$Z"
	awk -v H="$H" -v K="$K" -v Z="$Z" '
		function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
		function pretty(k) {
			gsub(/\$mod/, "Super", k); gsub(/XF86Audio/, "", k); gsub(/XF86MonBrightness/, "Bright", k)
			gsub(/Return/, "Enter", k); gsub(/slash/, "/", k); gsub(/minus/, "-", k); gsub(/comma/, ",", k)
			gsub(/space/, "Space", k); gsub(/\+Prior$/, "+PgUp", k); gsub(/\+Next$/, "+PgDn", k)
			return k
		}
		# Super+Shift+Left, Super+Shift+Right -> Super+Shift+Left/Right; 1..9 -> 1-9
		function group(   i, pre, suf, out, p) {
			if (n == 1) return ks[1]
			p = ks[1]; sub(/[^+]+$/, "", p)
			for (i = 2; i <= n; i++) { q = ks[i]; sub(/[^+]+$/, "", q); if (q != p) break }
			if (i <= n) { out = ks[1]; for (i = 2; i <= n; i++) out = out "  " ks[i]; return out }
			out = ""
			for (i = 1; i <= n; i++) { suf = substr(ks[i], length(p) + 1); out = out (i > 1 ? "/" : "") suf }
			if (n > 4) out = substr(ks[1], length(p) + 1) "-" substr(ks[n], length(p) + 1)
			return p out
		}
		function flush() { if (n) printf "  %s%-30s%s %s\n", K, group(), Z, last; n = 0 }
		/^## / { flush(); printf "\n%s%s%s\n", H, toupper(substr($0, 4)), Z; next }
		/^# / { flush(); last = trim(substr($0, 3)); next }
		/^bindsym/ {
			line = $0; sub(/^bindsym[ \t]+(--[a-z-]+[ \t]+)*/, "", line)
			ks[++n] = pretty(substr(line, 1, index(line " ", " ") - 1))
		}
		END { flush() }
	' "$binds"
}

vim_sheet() {
	printf '\n%s☀ EDITOR — solarvim%s  %s(Space = leader, :Keys inside nvim)%s\n\n' "$H" "$Z" "$D" "$Z"
	if command -v nvim >/dev/null 2>&1; then
		NVIM_APPNAME=solarvim nvim --headless '+lua if Solar then Solar.print_sheet() end' +qa 2>/dev/null |
			sed "s/^\([A-Z][A-Z]*\)\$/$H\1$Z/"
	else
		printf '  neovim is not installed\n'
	fi
}

fm_sheet() {
	printf '\n%s☀ FILES — muhfm%s  %s(Super+E, ? inside for help)%s\n' "$H" "$Z" "$D" "$Z"
	if command -v muhfm >/dev/null 2>&1; then
		muhfm --keys | awk -v H="$H" -v K="$K" -v Z="$Z" '
			/^## / { printf "\n%s%s%s\n", H, toupper(substr($0, 4)), Z; next }
			/^  / { printf "  %s%-20s%s %s\n", K, substr($0, 3, 20), Z, substr($0, 24); next }'
	else
		printf '  muhfm is not installed — run: install.sh --only muhfm\n'
	fi
}

all() {
	case ${1:-all} in
	sway) sway_sheet ;;
	vim) vim_sheet ;;
	fm | files | muhfm) fm_sheet ;;
	*) sway_sheet; vim_sheet; fm_sheet ;;
	esac
}

case ${1:-} in
--pager)
	shift
	all "${1:-all}" | less -R
	;;
-h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
*) all "${1:-all}" ;;
esac
