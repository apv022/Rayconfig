#!/usr/bin/env bash
# status — the entire bar. swaybar reads i3bar JSON from stdin, and with
# click_events on it writes clicks back to ours.
#
#   status          loop forever (what sway runs)
#   status --once   one line, for tests
#
# No jq, no modules, no plugin API. Reads sysfs, /proc, wpctl, state flags.
set -eu

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig
BIN=$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")

# shellcheck disable=SC1090,SC1091
[ -f "$STATE/theme.sh" ] && . "$STATE/theme.sh"
: "${RAY_FG:=#ffe9b0}" "${RAY_DIM:=#8a7a5a}" "${RAY_ACCENT:=#ffb000}"
: "${RAY_URGENT:=#dc143c}" "${RAY_BG:=#0b0b0b}"

out=
setting() { sed -n "s/^$1=//p" "$STATE/settings" 2>/dev/null | tail -n1; }

add() { # name text fg [bg]
	out="$out${out:+,}{\"name\":\"$1\",\"full_text\":\"$2\",\"color\":\"$3\""
	[ -n "${4:-}" ] && out="$out,\"background\":\"$4\""
	out="$out,\"separator\":false,\"separator_block_width\":14}"
}

# indicators for things you switched on, so nothing is on by surprise
seg_flags() {
	local p
	p=$(cat "$STATE/recording.pid" 2>/dev/null || true)
	if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then add rec " ● REC " "$RAY_BG" "$RAY_URGENT"; fi
	[ -e "$STATE/flag.dnd" ] && add dnd " dnd " "$RAY_ACCENT"
	[ -e "$STATE/flag.awake" ] && add awake " awake " "$RAY_ACCENT"
	return 0
}

seg_net() {
	for iface in /sys/class/net/*; do
		[ -r "$iface/operstate" ] || continue
		[ "$(cat "$iface/operstate")" = up ] || continue
		name=${iface##*/}
		case $name in lo | docker* | veth* | virbr* | vmnet* | tailscale* | tun* | wg*) continue ;; esac
		if [ -d "$iface/wireless" ]; then
			ssid=
			if command -v iw >/dev/null 2>&1; then
				ssid=$(iw dev "$name" link 2>/dev/null | awk '/SSID/ {print $2; exit}')
			fi
			add net " ${ssid:-wifi} " "$RAY_FG"
		else
			add net " wired " "$RAY_FG"
		fi
		return 0
	done
	add net " offline " "$RAY_DIM"
}

# CPU load from /proc/stat deltas between two bar updates
cpu_prev_total=0 cpu_prev_idle=0
seg_cpu() {
	local _ u n s i w q sq st total idle pct
	read -r _ u n s i w q sq st _ </proc/stat
	total=$((u + n + s + i + w + q + sq + st))
	idle=$((i + w))
	if [ "$cpu_prev_total" -gt 0 ] && [ "$total" -gt "$cpu_prev_total" ]; then
		pct=$((100 * ((total - cpu_prev_total) - (idle - cpu_prev_idle)) / (total - cpu_prev_total)))
		if [ "$pct" -ge 80 ]; then add cpu " cpu ${pct}% " "$RAY_URGENT"; else add cpu " cpu ${pct}% " "$RAY_DIM"; fi
	fi
	cpu_prev_total=$total cpu_prev_idle=$idle
}

seg_vol() {
	command -v wpctl >/dev/null 2>&1 || return 0
	raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return 0
	pct=$(printf '%s' "$raw" | awk '{printf "%d", $2 * 100}')
	case $raw in
	*MUTED*) add vol " vol mute " "$RAY_URGENT" ;;
	*) add vol " vol ${pct}% " "$RAY_DIM" ;;
	esac
}

seg_bat() {
	for bat in /sys/class/power_supply/BAT*; do
		[ -r "$bat/capacity" ] || continue
		pct=$(cat "$bat/capacity")
		st=$(cat "$bat/status" 2>/dev/null || echo Unknown)
		case $st in
		Charging)
			rm -f "$STATE/flag.batwarn"
			add bat " bat ${pct}%+ " "$RAY_ACCENT"
			;;
		Discharging)
			if [ "$pct" -le 15 ] || [ "$(setting bar_battery)" != off ]; then :; else return 0; fi
			if [ "$pct" -le 15 ]; then
				add bat " bat ${pct}% " "$RAY_URGENT"
				# warn once per discharge, as a sticky critical notification
				if [ "$pct" -le 10 ] && [ ! -e "$STATE/flag.batwarn" ] && command -v notify-send >/dev/null 2>&1; then
					: >"$STATE/flag.batwarn"
					notify-send -a ray -u critical "Battery low: ${pct}%" "Plug in soon." || true
				fi
			else
				add bat " bat ${pct}% " "$RAY_DIM"
			fi
			;;
		*) [ "$(setting bar_battery)" = off ] || add bat " bat ${pct}% " "$RAY_DIM" ;;
		esac
		return 0
	done
}

# Pending Arch updates, refreshed in the background at most every 30 min.
# checkupdates (pacman-contrib) uses a private db copy, so it never locks pacman.
seg_updates() {
	command -v checkupdates >/dev/null 2>&1 || return 0
	f=$STATE/updates
	if [ ! -f "$f" ] || [ -n "$(find "$f" -mmin +30 2>/dev/null)" ]; then
		mkdir -p "$STATE" && touch "$f"
		(checkupdates 2>/dev/null | wc -l >"$f.new" && mv "$f.new" "$f") >/dev/null 2>&1 &
	fi
	n=$(cat "$f" 2>/dev/null || echo 0)
	[ "${n:-0}" -gt 0 ] 2>/dev/null && add updates " ↑ $n updates · ray update " "$RAY_ACCENT"
	return 0
}

# the active keyboard layout, only when there is more than one to switch between
seg_kb() {
	case $(setting kb_layout) in *,*) ;; *) return 0 ;; esac
	command -v swaymsg >/dev/null 2>&1 || return 0
	l=$(swaymsg -t get_inputs 2>/dev/null | sed -n 's/.*"xkb_active_layout_name": "\([^"]*\)".*/\1/p' | head -n1)
	[ -n "$l" ] && add kb " $(printf '%s' "$l" | cut -c1-12) " "$RAY_DIM"
	return 0
}

emit() {
	out=
	seg_flags
	[ "${1:-}" = once ] || seg_updates
	[ "${1:-}" = once ] || [ "$(setting bar_cpu)" = off ] || seg_cpu
	[ "${1:-}" = once ] || seg_kb
	seg_net
	seg_vol
	seg_bat
	fmt=$(setting clock_format)
	add clock " $(date +"${fmt:-%a %d %b  %H:%M}" | sed 's/"/\\"/g') " "$RAY_FG"
	printf '[%s]\n' "$out"
}

# what a click on each segment does (button 1 left, 3 right, 4/5 wheel)
click() { # name button
	local r=$BIN/ray
	case $1:$2 in
	net:*) "$r" settings wifi ;;
	vol:1) "$r" settings sound ;;
	vol:3) "$BIN/vol" mute ;;
	vol:4) "$BIN/vol" up ;;
	vol:5) "$BIN/vol" down ;;
	cpu:*) foot --app-id ray-float btop ;;
	bat:*) "$r" settings power ;;
	updates:*) foot --app-id ray-float sh -c "'$r' update; printf '\nPress Enter to close '; read -r _" ;;
	rec:*) "$BIN/shot" record ;;
	dnd:*) "$r" toggle dnd ;;
	awake:*) "$r" toggle idle ;;
	kb:*) swaymsg input type:keyboard xkb_switch_layout next >/dev/null ;;
	clock:*) foot --app-id ray-float sh -c "cal -3; printf '\nPress Enter to close '; read -r _" ;;
	esac
}

case ${1:-} in
--once)
	emit once
	exit 0
	;;
-h | --help)
	printf 'usage: status [--once]\n'
	exit 0
	;;
esac

# i3bar protocol: a header, then an endless JSON array of status lines.
# Without the header swaybar falls back to plain text and shows raw JSON.
trap 'exit 0' INT TERM
printf '{"version":1,"click_events":true}\n[\n'
while :; do
	emit
	printf ','
	# wait up to 2s for a click; clicks arrive as one JSON object per line
	rc=0
	IFS= read -r -t 2 line || rc=$?
	if [ "$rc" -eq 0 ]; then
		if [[ $line =~ \"name\":\"([a-z]+)\" ]]; then
			name=${BASH_REMATCH[1]}
			btn=1
			[[ $line =~ \"button\":([0-9]+) ]] && btn=${BASH_REMATCH[1]}
			(click "$name" "$btn" </dev/null >/dev/null 2>&1 &)
		fi
	elif [ "$rc" -le 128 ]; then
		sleep 2 # stdin closed (no click events): don't spin
	fi
done
