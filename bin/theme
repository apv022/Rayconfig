#!/bin/sh
# theme — switch palette and reload the running session.
#
#   theme sunset
#   theme sunny
#   theme toggle
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig

cur=$(cat "$STATE/theme" 2>/dev/null || echo sunset)
case ${1:-} in
'' | -h | --help)
	printf 'usage: theme <sunset|sunny|toggle>\n' >&2
	exit 2
	;;
toggle)
	if [ "$cur" = sunset ]; then next=sunny; else next=sunset; fi
	;;
*) next=$1 ;;
esac

[ "$next" = "$cur" ] && [ "${2:-}" != "--force" ] && {
	printf 'theme: already %s\n' "$next"
	exit 0
}

"$ROOT/bin/gen-theme" "$next"

# Reload what's running. Each tool is optional.
if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_version >/dev/null 2>&1; then
	swaymsg reload >/dev/null 2>&1 && printf 'reloaded: sway\n'
fi
command -v makoctl >/dev/null 2>&1 && makoctl reload >/dev/null 2>&1 && printf 'reloaded: mako\n'

# swaybg is started from the sway config; restart it on a theme switch.
if command -v swaybg >/dev/null 2>&1 && [ -f "$STATE/wallpaper.png" ]; then
	pkill -x swaybg >/dev/null 2>&1 || true
	swaybg -i "$STATE/wallpaper.png" -m fill >/dev/null 2>&1 &
	printf 'reloaded: wallpaper\n'
fi

printf 'theme: %s (new foot windows pick up the palette)\n' "$next"
