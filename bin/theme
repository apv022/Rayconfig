#!/bin/sh
# theme — switch palette and reload the running session.
#
#   theme sunset
#   theme sunny
#   theme toggle
set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig

cur=$(cat "$STATE/theme" 2>/dev/null || echo sunset)
case ${1:-} in
'' | -h | --help)
	printf 'usage: theme <%s|toggle>\n' "$(ls "$ROOT/themes" | tr '\n' '|' | sed 's/|$//')" >&2
	exit 2
	;;
toggle)
	if [ "$cur" = sunset ]; then next=sunny; else next=sunset; fi
	;;
*) next=$1 ;;
esac

[ "$next" = "$cur" ] && [ "${2:-}" != "--force" ] && {
	printf 'theme: already %s\n' "$next"
	exit 0
}

"$ROOT/bin/gen-theme" "$next"

# Reload what's running. Each tool is optional.
if command -v swaymsg >/dev/null 2>&1 && swaymsg -t get_version >/dev/null 2>&1; then
	swaymsg reload >/dev/null 2>&1 && printf 'reloaded: sway\n'
fi
command -v makoctl >/dev/null 2>&1 && makoctl reload >/dev/null 2>&1 && printf 'reloaded: mako\n'

# GTK/Chromium/Electron apps (Brave, Firefox file pickers) follow this.
if command -v gsettings >/dev/null 2>&1; then
	case $(sed -n 's/^variant=//p' "$ROOT/themes/$next/palette") in
	light) gsettings set org.gnome.desktop.interface color-scheme prefer-light 2>/dev/null || true ;;
	*) gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true ;;
	esac
fi
command -v notify-send >/dev/null 2>&1 && notify-send -a ray "Theme" "$next" || true

printf 'theme: %s (new foot windows pick up the palette)\n' "$next"
