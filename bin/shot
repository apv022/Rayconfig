#!/bin/sh
# shot — screenshots, screen recording and a colour picker. grim, slurp,
# wf-recorder; no wrapper app.
#
#   shot region          select an area, copy to clipboard
#   shot save            select an area, save to ~/Pictures/screenshots
#   shot full            whole output, saved
#   shot edit            select an area, annotate it (satty), else save
#   shot record [screen] [audio|mic]   start/stop recording (~/Videos/recordings)
#   shot text            select an area, copy the text in it (OCR, tesseract)
#   shot qr              select a QR code, copy what it says (zbar)
#   shot color           pick a pixel, copy its #hex
set -eu

STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig
dir=${RAY_SHOT_DIR:-$HOME/Pictures/screenshots}
vids=${RAY_RECORD_DIR:-$HOME/Videos/recordings}
stamp() { date +%Y%m%d-%H%M%S; }
note() { command -v notify-send >/dev/null 2>&1 && notify-send -a ray "$@" || true; }

case ${1:-region} in
region)
	sel=$(slurp) || exit 0
	grim -g "$sel" - | wl-copy
	note "Screenshot" "copied to the clipboard"
	;;
save)
	mkdir -p "$dir"
	sel=$(slurp) || exit 0
	f="$dir/$(stamp).png"
	grim -g "$sel" "$f"
	note "Screenshot" "$f"
	printf 'shot: %s\n' "$f"
	;;
full)
	mkdir -p "$dir"
	f="$dir/$(stamp).png"
	grim "$f"
	note "Screenshot" "$f"
	printf 'shot: %s\n' "$f"
	;;
edit)
	mkdir -p "$dir"
	sel=$(slurp) || exit 0
	f="$dir/$(stamp).png"
	if command -v satty >/dev/null 2>&1; then
		grim -g "$sel" - | satty --filename - --output-filename "$f" --copy-command wl-copy --early-exit
	else
		grim -g "$sel" "$f"
		note "Screenshot" "saved (install satty to annotate): $f"
	fi
	;;
record)
	pidf=$STATE/recording.pid
	if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
		kill -INT "$(cat "$pidf")"
		rm -f "$pidf"
		note "Recording saved" "$(cat "$STATE/recording.file" 2>/dev/null)"
		exit 0
	fi
	rm -f "$pidf"
	command -v wf-recorder >/dev/null 2>&1 || { note "Recording" "wf-recorder is not installed — run ray update"; exit 1; }
	mkdir -p "$vids" "$STATE"
	f="$vids/$(stamp).mp4"
	geo=
	if [ "${2:-region}" != screen ]; then
		geo=$(slurp) || exit 0
	fi
	# desktop audio is the default sink's monitor; mic is the default source
	audio=
	case ${3:-} in
	audio) audio="--audio=$(pactl get-default-sink 2>/dev/null).monitor" ;;
	mic) audio=--audio ;;
	esac
	# shellcheck disable=SC2086 # $audio is one optional flag
	nohup wf-recorder ${geo:+-g "$geo"} $audio -f "$f" >/dev/null 2>&1 &
	printf '%s\n' "$!" >"$pidf"
	printf '%s\n' "$f" >"$STATE/recording.file"
	note "Recording" "Super+Alt+R again (or click ● REC in the bar) to stop"
	;;
text | ocr)
	command -v tesseract >/dev/null 2>&1 || { note "Text capture" "needs tesseract: Install → Package → tesseract-data-eng"; exit 1; }
	sel=$(slurp) || exit 0
	txt=$(grim -g "$sel" - | tesseract - - 2>/dev/null | tr -d '\f')
	[ -n "$txt" ] || { note "Text capture" "no text found"; exit 0; }
	printf '%s' "$txt" | wl-copy
	note "Text copied" "$(printf '%s' "$txt" | head -c 120)"
	;;
qr)
	command -v zbarimg >/dev/null 2>&1 || { note "QR capture" "needs zbar: Install → Package → zbar"; exit 1; }
	sel=$(slurp) || exit 0
	txt=$(grim -g "$sel" -t png - | zbarimg -q --raw - 2>/dev/null)
	[ -n "$txt" ] || { note "QR capture" "no QR code found"; exit 0; }
	printf '%s' "$txt" | wl-copy
	note "QR code copied" "$txt"
	;;
color | colour)
	pos=$(slurp -p) || exit 0
	# a 1×1 binary PPM: the last three bytes are the pixel
	hex=$(grim -g "$pos" -t ppm - | tail -c 3 | od -An -tx1 | tr -d ' \n')
	printf '#%s' "$hex" | wl-copy -n
	note "Colour #$hex" "copied to the clipboard"
	printf '#%s\n' "$hex"
	;;
*)
	printf 'usage: shot region|save|full|edit|record [screen] [audio|mic]|text|qr|color\n' >&2
	exit 2
	;;
esac
