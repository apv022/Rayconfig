		'Bash cheat sheet|learn_web https://devhints.io/bash'
}
learn_keys() { exec foot --app-id ray-float -e "$ROOT/bin/keys" --pager "${1:-all}"; }
learn_readme() { exec foot --app-id ray-float -e less "$ROOT/README.md"; }
learn_man() { exec foot --app-id ray-float -e man 5 sway; }
learn_web() { exec xdg-open "$1"; }

menu_trigger() {
	submenu "Trigger" 'Capture|menu_capture' 'Toggle|menu_toggle' 'Clipboard history|clipboard' 'Emoji|emoji' \
		'Reminder|menu_reminder' 'Hardware|menu_hardware' 'Speed test|menu_tests'
}
menu_capture() {
	local rec='Record a region|shot record'
	[ -f "$STATE/recording.pid" ] && rec='Stop recording|shot record'
	submenu "Capture" 'Screenshot region → clipboard|shot region' 'Screenshot region → file|shot save' \
		'Screenshot screen → file|shot full' 'Screenshot → annotate|shot edit' "$rec" \
		'Record screen, no audio|shot record screen' 'Record screen + desktop audio|shot record screen audio' \
		'Record screen + microphone|shot record screen mic' 'Text on screen → clipboard (OCR)|shot text' \
		'QR code on screen → clipboard|shot qr' 'Pick a colour|shot color'
}
shot() { exec "$ROOT/bin/shot" "$@"; }
menu_toggle() {
	submenu "Toggle" "Night light ($(onoff flag nightlight))|t_nightlight" "Keep awake ($(onoff flag awake))|toggle idle" \
		"Do not disturb ($(onoff flag dnd))|toggle dnd" "Screensaver ($(get screensaver || echo on))|toggle screensaver" \
		'Bar|toggle bar' 'Gaps|toggle gaps' 'This window see-through|toggle opacity'
}
menu_reminder() { submenu "Reminder" 'Set one|reminder_set' 'Show all|reminder_list' 'Clear all|reminder_clear'; }
# Reminders are transient systemd user timers: no daemon, gone after reboot.
reminder_set() {
	local m t
	m=$(printf '5\n10\n15\n25\n30\n45\n60\n90\n120\n' | pick "Remind me in (minutes)" 9) || return 0
	t=$(ask_text "Remind me to…") || return 0
	systemd-run --user --quiet --unit "ray-remind-$(date +%s)" --on-active="${m}m" --timer-property=AccuracySec=1s \
		notify-send -a ray -u critical "Reminder" "${t:-time is up}"
	note "Reminder" "in $m min: ${t:-time is up}"
}
reminder_list() {
	local l
	l=$(systemctl --user list-timers 'ray-remind-*' --no-legend 2>/dev/null | awk '{print $1, $2, $3, $4}')
	note "Reminders" "${l:-none}"
}
reminder_clear() {
	systemctl --user stop 'ray-remind-*.timer' 2>/dev/null || true
	note "Reminders" "cleared"
}
menu_hardware() {
	submenu "Hardware" 'Laptop screen on / off|hw_laptop' 'Touchpad on / off|hw_touchpad' 'Touchscreen on / off|hw_touch'
}
hw_laptop() {
	local o
	o=$(swaymsg -t get_outputs -p | sed -n 's/^Output \(eDP[^ ]*\).*/\1/p' | head -n1)
	[ -n "$o" ] || { note "Laptop screen" "no built-in screen found"; return 0; }
	swaymsg output "$o" toggle >/dev/null && note "Laptop screen" "$o toggled"
}
hw_touchpad() { if [ "$(get touchpad || echo enabled)" = enabled ]; then set_ touchpad disabled; else set_ touchpad enabled; fi; note "Touchpad" "$(get touchpad)"; }
hw_touch() { if [ "$(get touchscreen || echo enabled)" = enabled ]; then set_ touchscreen disabled; else set_ touchscreen enabled; fi; note "Touchscreen" "$(get touchscreen)"; }
menu_tests() { submenu "Speed test" 'Network|s_speedtest' 'Disk|disk_test'; }
disk_test() {
	float_sh "f=\$HOME/.ray-disk-test; echo 'Writing 1 GB to your home disk…'; dd if=/dev/zero of=\$f bs=1M count=1024 oflag=direct conv=fsync status=progress 2>&1 | tail -n1; echo 'Reading it back…'; dd if=\$f of=/dev/null bs=1M iflag=direct status=progress 2>&1 | tail -n1; rm -f \$f"
}

menu_style() {
	submenu "Appearance" 'Theme|s_theme' 'Next theme|style_next' 'Light / dark|style_toggle' 'Font|s_font' \
		'Font size|s_fontsize' 'Background|s_wallpaper' 'Next background|wallpaper_next' 'Icons|s_icons' \
		'Bar|s_bar' 'Windows|s_windows' 'Boot splash in this theme|style_splash' 'Screensaver text|s_saver_text' \
		'Edit this theme|style_edit'
}
style_next() { exec "$ROOT/bin/theme" next; }
style_toggle() { exec "$ROOT/bin/theme" toggle; }
style_splash() { float_sh "'$ROOT/bin/ray' splash"; }
style_edit() { exec foot -e "$ROOT/bin/ray" edit theme; }
s_fontsize() {
	choose font_size "Font size (terminal, launcher, notifications)" 11 '9|small' '10|compact' '11|normal' '12|large' '14|larger' '16|huge' || return 0
	"$ROOT/bin/gen-theme" "$(cat "$STATE/theme" 2>/dev/null || echo sunset)" >/dev/null
	have makoctl && makoctl reload 2>/dev/null || true
	note "Font size" "$(get font_size) — new windows use it"
}
# GTK icon themes: anything installed in /usr/share/icons that is not just cursors.
s_icons() {
	local t
	t=$(for d in /usr/share/icons/*/ "$HOME"/.local/share/icons/*/; do
		[ -f "$d/index.theme" ] || continue
		# skip cursor-only themes
		if [ ! -d "$d/cursors" ] || [ -d "$d/apps" ] || [ -d "$d/scalable" ]; then basename "$d"; fi
	done | sort -u | grep -vx default | pick "Icons ($(get icons || echo Adwaita)) — more: Install → Icons" 12) || return 0
	set_ icons "$t"
	have gsettings && gsettings set org.gnome.desktop.interface icon-theme "$t" 2>/dev/null || true
	for g in gtk-3.0 gtk-4.0; do
		f=$CFG/$g/settings.ini
		mkdir -p "$CFG/$g"
		[ -f "$f" ] || printf '[Settings]\n' >"$f"
		if grep -q '^gtk-icon-theme-name' "$f"; then sed -i "s/^gtk-icon-theme-name.*/gtk-icon-theme-name=$t/" "$f"; else sed -i "/^\[Settings\]/a gtk-icon-theme-name=$t" "$f"; fi
	done
	note "Icons" "$t"
}

# Curated official-repo lists. Each entry: "package(s)|label".
pkgs_menu() { # title entry...
	local title=$1 c o
	shift
	c=$(for o; do
		if pacman -Qq ${o%%|*} >/dev/null 2>&1; then printf '✓ %s\n' "${o#*|}"; else printf '  %s\n' "${o#*|}"; fi
	done | pick "$title" "$#") || return 0
	c=${c#??}
	for o; do
		[ "${o#*|}" = "$c" ] && float_sh "sudo pacman -S --needed ${o%%|*}"
	done
}
menu_install() {
	submenu "Install" 'Package|install_pkg' 'Browser|i_browser' 'Terminal|i_terminal' 'Editor|i_editor' 'TUI apps|i_tui' \
		'Development|i_dev' 'AI|i_ai' 'Office & media|i_media' 'Icons|i_icons' 'Font|install_font' 'Web app|webapp add' \
		'Recommended apps|i_recommended'
}
i_browser() { pkgs_menu "Browser" 'chromium|Chromium' 'firefox|Firefox' 'torbrowser-launcher|Tor Browser' 'epiphany|GNOME Web'; }
i_terminal() { pkgs_menu "Terminal" 'alacritty|Alacritty' 'kitty|Kitty' 'ghostty|Ghostty' 'wezterm|WezTerm'; }
i_editor() { pkgs_menu "Editor" 'helix|Helix' 'code|Code - OSS' 'zed|Zed' 'emacs-wayland|Emacs' 'gnome-text-editor|Text Editor'; }
i_tui() {
	pkgs_menu "TUI apps" 'lazygit|lazygit' 'lazydocker|lazydocker' 'btop|btop' 'ncdu|ncdu (disk usage)' \
		'yazi|yazi' 'bottom|bottom' 'gitui|gitui' 'newsboat|newsboat (RSS)' 'cmus|cmus (music)'
}
i_dev() {
	pkgs_menu "Development" 'go gopls|Go' 'rustup|Rust (rustup)' 'nodejs npm|Node.js' 'python python-pip|Python' \
		'zig zls|Zig' 'jdk-openjdk|Java' 'dotnet-sdk|.NET' 'ruby|Ruby' 'php composer|PHP' 'elixir|Elixir' \
		'docker docker-compose docker-buildx|Docker' 'podman|Podman' 'github-cli|GitHub CLI' 'mise|mise (version manager)'
}
i_ai() {
	local c
	c=$(printf '  Claude Code\n  Ollama (local models)\n' | pick "AI" 2) || return 0
	case ${c#  } in
	'Claude Code') float_sh "curl -fsSL https://claude.ai/install.sh | bash" ;;
	Ollama*) float_sh "sudo pacman -S --needed ollama && systemctl --user enable --now ollama 2>/dev/null || sudo systemctl enable --now ollama" ;;
	esac
}
i_media() {
	pkgs_menu "Office & media" 'libreoffice-fresh|LibreOffice' 'gimp|GIMP' 'inkscape|Inkscape' 'krita|Krita' \
		'obs-studio|OBS Studio' 'kdenlive|Kdenlive' 'audacity|Audacity' 'signal-desktop|Signal' 'obsidian|Obsidian' \
		'localsend|LocalSend'
}
i_icons() { pkgs_menu "Icons" 'papirus-icon-theme|Papirus' 'adwaita-icon-theme|Adwaita' 'breeze-icons|Breeze'; }
i_recommended() { float_sh "'$ROOT/bootstrap/install.sh' --only packages --extras"; }
menu_remove() { submenu "Remove" 'Package|remove_pkg' 'Web app|webapp remove' 'Reminders|reminder_clear'; }

menu_update() {
	submenu "Update" 'Everything|update_float' 'Firmware|u_firmware' 'Restart|menu_restart' 'Refresh configs|u_refresh' \
		'Sync the clock|s_timesync' 'Password|s_password'
}
update_float() { float_sh "'$ROOT/bin/ray' update"; }
u_firmware() { if have fwupdmgr; then float_sh "fwupdmgr refresh --force; fwupdmgr update"; else note "Firmware" "fwupd is not installed — run ray update"; fi; }
u_refresh() { float_sh "'$ROOT/bootstrap/install.sh' --only link,muhfm,theme --yes"; }
menu_restart() {
	submenu "Restart" 'Desktop pieces (bar, notifications, idle)|restart' 'Audio|r_audio' 'Wi-Fi|r_wifi' \
		'Bluetooth|r_bluetooth' 'Touchpad|r_touchpad'
}
r_audio() { systemctl --user restart pipewire pipewire-pulse wireplumber && note "Audio" "restarted"; }
r_wifi() { float_sh "sudo systemctl restart NetworkManager && echo 'Wi-Fi restarted.'"; }
r_bluetooth() { float_sh "sudo systemctl restart bluetooth && echo 'Bluetooth restarted.'"; }
r_touchpad() { swaymsg input type:touchpad events disabled >/dev/null && sleep 1 && swaymsg input type:touchpad events enabled >/dev/null && note "Touchpad" "restarted"; }

menu_power() {
	local items=('Lock|p_lock' 'Screensaver|screensaver' 'Suspend|p_suspend')
	[ "$(wc -l </proc/swaps)" -gt 1 ] && items+=('Hibernate|p_hibernate')
	items+=('Log out|p_logout' 'Reboot|p_reboot')
	[ -d /sys/firmware/efi ] && items+=('Reboot to firmware setup|p_firmware')
	items+=('Power off|p_poweroff')
	submenu "Power" "${items[@]}"
}
p_lock() { exec swaylock -f; }
p_suspend() { exec systemctl suspend; }
p_hibernate() { exec systemctl hibernate; }
p_logout() { exec swaymsg exit; }
p_reboot() { exec systemctl reboot; }
p_firmware() { exec systemctl reboot --firmware-setup; }
p_poweroff() { exec systemctl poweroff; }

menu() {
	case ${1:-} in
	'') ;;
	apps) exec fuzzel ;;
	learn) menu_learn; return ;;
	trigger) menu_trigger; return ;;
	capture) menu_capture; return ;;
	toggle) menu_toggle; return ;;
	style | appearance) menu_style; return ;;
	setup | settings) settings; return ;;
	install) menu_install; return ;;
	remove) menu_remove; return ;;
	update) menu_update; return ;;
	about) about; return ;;
	power | system) menu_power; return ;;
	*) echo "ray menu: unknown menu $1" >&2; return 2 ;;
	esac
	submenu "ray" 'Apps|apps' 'Learn|menu_learn' 'Trigger|menu_trigger' 'Appearance|menu_style' 'Setup|settings' \
		'Install|menu_install' 'Remove|menu_remove' 'Update|menu_update' 'About|about' 'Ask an agent|ask' \
		'Health check|health' 'System|menu_power'
}
apps() { exec fuzzel; }
about() { float_sh "fastfetch 2>/dev/null || uname -a"; }
health() { float_sh "'$ROOT/bin/doctor'"; }

# ---------------------------------------------------------------- main

sub=${1:-}
[ $# -gt 0 ] && shift
case $sub in
settings | set | setup) settings "$@" ;;
_render) render_settings ;;
_set) set_ "$1" "${2:-}" ;; # ray _set kb_layout de — what the menus call
_defaults) defaults ;;
_saver) saver ;;
splash) splash ;;
install) if [ $# -gt 0 ] && [ "${1#-}" != "$1" ]; then exec "$ROOT/bootstrap/install.sh" "$@"; else install_pkg "${1:-}"; fi ;;
remove) remove_pkg "${1:-}" ;;
update | upgrade) update ;;
_update_rest) update_rest ;;
restart) restart ;;
menu) menu "$@" ;;
ask) ask ;;
doctor) exec "$ROOT/bin/doctor" "$@" ;;
theme) exec "$ROOT/bin/theme" "${@:-toggle}" ;;
font) s_font ;;
wallpaper) if [ "${1:-}" = next ]; then wallpaper_next; else s_wallpaper; fi ;;
toggle) toggle "$@" ;;
idle) idle_start ;;
screensaver) screensaver "$@" ;;
clipboard) clipboard ;;
files) # muhfm with the editor from Settings → Defaults → Editor
	ed=$(get editor || true)
	if [ -n "$ed" ]; then export EDITOR="$ed" VISUAL="$ed"; fi
	export EDITOR="${EDITOR:-env NVIM_APPNAME=solarvim nvim}"
	exec muhfm "${1:-$HOME}"
	;;
remind) reminder_set ;;
emoji) emoji ;;
browser) browser "$@" ;;
webapp) webapp "$@" ;;
status) exec "$ROOT/bin/status" "${@:---once}" ;;
keys) exec "$ROOT/bin/keys" "$@" ;;
startup) # run once per sway start
	idle_start
	if have cliphist; then
		setsid -f wl-paste --watch cliphist store >/dev/null 2>&1
		setsid -f wl-paste --type image --watch cliphist store >/dev/null 2>&1
	fi
	flag_clear dnd
	flag_clear awake
	flag_clear nogaps
	flag_clear opaque
	if [ "$(get nightlight || true)" = on ] && have wlsunset; then
		flag_set nightlight
		nightlight_start
	else
		flag_clear nightlight
	fi
	[ -f "$STATE/welcomed" ] && exit 0
	mkdir -p "$STATE" && : >"$STATE/welcomed"
	note "Welcome to Rayconfig" "Super+Alt+Space  menu
Super+I  settings
Super+/  every shortcut
Super+E  files"
	;;
edit)
	ed=${EDITOR:-nvim}
	case ${1:-} in
	sway | foot | mako | fuzzel | swaylock | muhfm) exec "$ed" "$ROOT/dots/$1" ;;
	settings | state) exec "$ed" "$SETTINGS" ;;
	theme | palette) exec "$ed" "$ROOT/themes/$(cat "$STATE/theme" 2>/dev/null || echo sunset)/palette" ;;
	vim | solarvim) exec "$ed" "$CFG/solarvim/init.lua" ;;
	local) exec "$ed" "$CFG/sway/config.d/90-local.conf" ;;
	*) cd "$ROOT" && exec "$ed" . ;;
	esac
	;;
'' | -h | --help | help) usage ;;
*)
	printf 'ray: unknown command: %s\n\n' "$sub" >&2
	usage >&2
	exit 2
	;;
esac
