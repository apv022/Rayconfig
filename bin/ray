#!/usr/bin/env bash
# ray — the one command you need to remember. Everything is also in the
# menus (Super+Alt+Space system, Super+I settings), so you never need it.
#
# Every feature is one small function below. No plugins, no hooks, no
# module loader: to change something, edit the function.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/rayconfig
CFG=${XDG_CONFIG_HOME:-$HOME/.config}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
SV=$DATA/solarvim
MF=$DATA/muhfm
APPS=$DATA/applications
SETTINGS=$STATE/settings
SWAYGEN=$ROOT/dots/sway/config.d/85-settings.conf # gitignored, generated

# A session without a UTF-8 locale (LANG=C) makes btop and other TUIs refuse
# to start. C.UTF-8 is built into glibc, so it is always there as a fallback.
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
*[Uu][Tt][Ff]-8 | *[Uu][Tt][Ff]8) ;;
*) export LANG=C.UTF-8 && unset LC_ALL ;;
esac

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
	H=$'\033[1;38;5;180m' G=$'\033[38;5;149m' R=$'\033[38;5;174m' Z=$'\033[0m'
else H='' G='' R='' Z=''; fi
step() { printf '\n%s● %s%s\n' "$H" "$*" "$Z"; }
note() { if command -v notify-send >/dev/null 2>&1; then notify-send -a ray "$@" || true; fi; }
have() { command -v "$1" >/dev/null 2>&1; }
in_sway() { have swaymsg && swaymsg -t get_version >/dev/null 2>&1; }

usage() {
	cat <<EOF
${H}ray${Z} — Rayconfig

  ray menu [name]      system menu (Super+Alt+Space); name: apps learn trigger
                       capture toggle appearance setup install remove update about power
  ray settings [what]  settings hub (Super+I); what: keyboard mouse idle display
                       network security region bar windows nightlight …
  ray files [dir]      muhfm with your editor (Super+E)
  ray remind           set a reminder
  ray update           update everything: Arch, rayconfig, solarvim, muhfm
  ray theme [name]     any theme in themes/, toggle, next, prev, list
  ray font             pick the font for every app
  ray splash           boot splash in the current theme (sudo, rebuilds initramfs)
  ray wallpaper [next] pick or cycle the wallpaper
  ray toggle <what>    nightlight idle dnd bar gaps opacity
  ray clipboard        clipboard history (Super+Ctrl+V)
  ray emoji            emoji picker (Super+.)
  ray webapp add NAME URL | remove | list
  ray install [pkg]    pick a package from the official repos
  ray remove [pkg]     pick an installed package to remove
  ray keys [sway|vim|fm] cheat sheets (Super+/)
  ray screensaver      start it now
  ray ask              open an AI agent inside your config repo
  ray doctor           health check, read-only
  ray edit [what]      sway | foot | mako | fuzzel | swaylock | muhfm | theme | vim | local
EOF
}

# ---------------------------------------------------------------- pickers

# fuzzel is the GUI: every choice is a small floating list, no typing needed.
pick() { # prompt [lines] — choices on stdin
	fuzzel --dmenu --prompt "$1  " --lines "${2:-10}" --width 44 2>/dev/null
}
# a one-line text box: fuzzel with no list
ask_text() { # prompt
	fuzzel --dmenu --prompt "$1  " --lines 0 --width 60 </dev/null 2>/dev/null
}
confirm() { # question
	[ "$(printf 'No\nYes\n' | pick "$1" 2)" = Yes ]
}
# Run a TUI in a centred floating terminal; keep it open if it fails.
tui() { # title cmd...
	local title=$1
	shift
	exec foot --app-id ray-float --title "$title" sh -c '"$@" || { printf "\nPress Enter to close "; read -r _; }' sh "$@"
}
# A shell snippet in a floating terminal that waits for Enter at the end.
float_sh() { exec foot --app-id ray-float sh -c "$1; printf '\nPress Enter to close '; read -r _"; }

# ---------------------------------------------------------------- settings state

# State is a plain key=value file; 85-settings.conf is rendered from it.
# get KEY: the stored value; fails when unset or empty, so `get k || echo default` works
get() {
	local v
	v=$(sed -n "s/^$1=//p" "$SETTINGS" 2>/dev/null | tail -n1)
	[ -n "$v" ] || return 1
	printf '%s\n' "$v"
}
set_() {
	mkdir -p "$STATE"
	touch "$SETTINGS"
	grep -v "^$1=" "$SETTINGS" >"$SETTINGS.tmp" || true
	printf '%s=%s\n' "$1" "$2" >>"$SETTINGS.tmp"
	mv "$SETTINGS.tmp" "$SETTINGS"
	render_settings
}
render_settings() {
	local v l
	{
		echo "# generated by \`ray settings\` from $SETTINGS — edit there or use Super+I"
		echo 'input "type:keyboard" {'
		l=$(get kb_layout || true)
		[ -n "$l" ] && echo "	xkb_layout $l"
		v=$(get kb_variant || true)
		[ -n "$v" ] && echo "	xkb_variant $v"
		# xkb options: layout switch key (only with 2+ layouts), caps lock, compose
		v=$(printf '%s\n' "$(get kb_switch || echo grp:alt_shift_toggle)" "$(get kb_caps || true)" "$(get kb_compose || true)" |
			{ grep -v '^$' || true; } | paste -sd, -)
		case $l in *,*) ;; *) v=$(printf '%s' "$v" | sed 's/grp:[a-z_]*//; s/,,*/,/g; s/^,//; s/,$//') ;; esac
		[ -n "$v" ] && echo "	xkb_options $v"
		v=$(get repeat_rate || true)
		[ -n "$v" ] && echo "	repeat_rate $v"
		v=$(get repeat_delay || true)
		[ -n "$v" ] && echo "	repeat_delay $v"
		v=$(get numlock || true)
		[ -n "$v" ] && echo "	xkb_numlock $v"
		echo '}'
		echo 'input "type:pointer" {'
		v=$(get mouse_speed || true)
		[ -n "$v" ] && echo "	pointer_accel $v"
		v=$(get mouse_accel || true)
		[ -n "$v" ] && echo "	accel_profile $v"
		v=$(get mouse_natural || true)
		[ -n "$v" ] && echo "	natural_scroll $v"
		echo '}'
		echo 'input "type:touchpad" {'
		for v in natural_scroll:natural_scroll tap:tap dwt:dwt scroll_factor:scroll_factor \
			click_method:click_method touchpad_speed:pointer_accel touchpad:events; do
			l=$(get "${v%%:*}" || true)
			[ -n "$l" ] && echo "	${v#*:} $l"
		done
		echo '}'
		v=$(get touchscreen || true)
		[ -n "$v" ] && printf 'input "type:touch" {\n\tevents %s\n}\n' "$v"
		v=$(get gaps || true)
		[ -n "$v" ] && echo "gaps inner $v" && echo "gaps outer $(( v / 2 ))"
		v=$(get border || true)
		case $v in '') ;; title) echo "default_border normal 2" ;; *) echo "default_border pixel $v" && echo "default_floating_border pixel $v" ;; esac
		v=$(get focus_follows_mouse || true)
		[ -n "$v" ] && echo "focus_follows_mouse $v"
		v=$(get workspace_layout || true)
		[ -n "$v" ] && echo "workspace_layout $v"
		v=$(get bar_position || true)
		[ -n "$v" ] && echo "bar main position $v"
		[ "$(get bar_background || true)" = clear ] && echo "bar main colors background #00000000"
		{ grep '^output_' "$SETTINGS" 2>/dev/null || true; } | while IFS='=' read -r k v; do
			k=${k#output_}
			echo "output ${k%%__*} ${k#*__} $v"
		done
		v=$(get wallpaper || true)
		if [ -n "$v" ]; then echo "output * bg \"$v\" fill"; fi
	} >"$SWAYGEN"
	if in_sway; then swaymsg reload >/dev/null 2>&1 || true; fi
}
# flags: tiny files the bar reads to show what is switched on
flag() { [ -e "$STATE/flag.$1" ]; }
flag_set() { mkdir -p "$STATE" && : >"$STATE/flag.$1"; }
flag_clear() { rm -f "$STATE/flag.$1"; }

# ---------------------------------------------------------------- settings

s_wifi() {
	if have impala; then tui "Wi-Fi" impala; else tui "Wi-Fi" nmtui; fi
}
s_bluetooth() {
	systemctl is-active -q bluetooth 2>/dev/null || float_sh "echo 'Starting bluetooth (asks for your password once)…'; sudo systemctl enable --now bluetooth"
	if have bluetui; then tui "Bluetooth" bluetui; else tui "Bluetooth" bluetoothctl; fi
}
s_sound() {
	if have wiremix; then tui "Sound" wiremix
	elif have pulsemixer; then tui "Sound" pulsemixer
	else tui "Sound" alsamixer; fi
}
s_theme() {
	local t cur
	cur=$(cat "$STATE/theme" 2>/dev/null || echo sunset)
	t=$("$ROOT/bin/theme" list | while read -r n; do
		v=$(sed -n 's/^variant=//p' "$ROOT/themes/$n/palette")
		d=$(sed -n '1s/^# [^:]*: *//p' "$ROOT/themes/$n/palette")
		mark=' '
		[ "$n" = "$cur" ] && mark='●'
		printf '%s %-17s %-5s  %s\n' "$mark" "$n" "$v" "$d"
	done | pick "Theme" 17) || return 0
	t=$(printf '%s' "$t" | awk '{print $2}')
	"$ROOT/bin/theme" "$t"
}
s_font() {
	have fc-list || { note "Font" "fontconfig is missing"; return 0; }
	local f
	# monospace families first: the terminal, editor and bar all use this one
	f=$(fc-list :spacing=mono family | cut -d, -f1 | sort -u | pick "Font ($(get font || echo 'JetBrains Mono'))" 15) || return 0
	set_ font "$f"
	"$ROOT/bin/gen-theme" "$(cat "$STATE/theme" 2>/dev/null || echo sunset)" >/dev/null
	if in_sway; then swaymsg reload >/dev/null 2>&1 || true; fi
	have makoctl && makoctl reload 2>/dev/null || true
	note "Font" "$f — new terminal windows use it. More fonts: Super+Alt+Space → Install → Font"
}
s_wallpaper() {
	local dir=$HOME/Pictures/wallpapers f
	mkdir -p "$dir"
	f=$( { echo "theme default"; find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -printf '%f\n' | sort; } |
		pick "Wallpaper (~/Pictures/wallpapers)" 10) || return 0
	if [ "$f" = "theme default" ]; then set_ wallpaper ""; else set_ wallpaper "$dir/$f"; fi
}
wallpaper_next() {
	local dir=$HOME/Pictures/wallpapers cur list n i
	cur=$(get wallpaper || true)
	list=$( { echo ""; find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | sort; })
	n=$(printf '%s\n' "$list" | wc -l)
	i=$(printf '%s\n' "$list" | grep -nxF -- "$cur" | head -n1 | cut -d: -f1)
	i=$(( ${i:-1} % n + 1 ))
	set_ wallpaper "$(printf '%s\n' "$list" | sed -n "${i}p")"
}
# choose: a list setting. Each option is "value|label"; the current one gets
# a ●, the choice is stored and sway re-rendered. Returns 1 on Escape.
choose() { # key title default option...
	local key=$1 title=$2 def=$3 cur o c
	shift 3
	cur=$(get "$key" || true)
	cur=${cur:-$def}
	c=$(for o; do
		if [ "${o%%|*}" = "$cur" ]; then printf '● %s\n' "${o#*|}"; else printf '  %s\n' "${o#*|}"; fi
	done | pick "$title" "$#") || return 1
	c=${c#??}
	for o; do
		if [ "${o#*|}" = "$c" ]; then
			set_ "$key" "${o%%|*}"
			return 0
		fi
	done
	return 1
}
# a submenu: "Label|function" pairs, Escape goes back up
submenu() { # title item...
	local title=$1 c o
	shift
	c=$(for o; do printf '  %s\n' "${o%%|*}"; done | pick "$title" "$#") || return 0
	c=${c#  }
	for o; do
		if [ "${o%%|*}" = "$c" ]; then
			${o#*|}
			return 0
		fi
	done
}

# ---- keyboard

s_keyboard() {
	submenu "Keyboard ($(get kb_layout || echo us))" \
		'Layouts|s_kb_layouts' 'Variant|s_kb_variant' 'Switch layouts with|s_kb_switch' \
		'Caps Lock key|s_kb_caps' 'Compose key|s_kb_compose' 'Repeat speed|s_kb_rate' \
		'Repeat delay|s_kb_delay' 'Num Lock at start|s_kb_numlock' 'Edit my keybindings|s_keybindings'
}
s_kb_layouts() {
	local cur l all
	cur=$(get kb_layout || echo us)
	all='us gb us(intl) de fr es it pt br ca se no dk fi pl cz hu ru ua gr tr jp kr in ara il'
	l=$(for l in $all; do
		case ",$cur," in *",$l,"*) printf '✓ %s\n' "$l" ;; *) printf '  %s\n' "$l" ;; esac
	done | pick "Layouts: $cur (pick to add or remove)" 15) || return 0
	l=${l#??}
	case ",$cur," in
	*",$l,"*) cur=$(printf '%s' ",$cur," | sed "s/,$l,/,/; s/^,//; s/,$//") ;;
	*) cur="$cur,$l" ;;
	esac
	set_ kb_layout "${cur:-us}"
	note "Keyboard" "layouts: ${cur:-us}$(case $cur in *,*) echo " — switch with $(get kb_switch | sed 's/grp://; s/_toggle//; s/_/+/g')" ;; esac)"
}
s_kb_variant() {
	choose kb_variant "Variant of $(get kb_layout || echo us)" '' '|standard' 'intl|international (dead keys)' \
		'altgr-intl|international, AltGr dead keys' 'dvorak|Dvorak' 'colemak|Colemak' 'colemak_dh|Colemak-DH' 'nodeadkeys|no dead keys'
}
s_kb_switch() {
	choose kb_switch "Switch layouts with" grp:alt_shift_toggle 'grp:alt_shift_toggle|Alt+Shift' \
		'grp:ctrl_shift_toggle|Ctrl+Shift' 'grp:alts_toggle|both Alt keys' 'grp:caps_toggle|Caps Lock' 'grp:win_space_toggle|Super+Space'
}
s_kb_caps() {
	choose kb_caps "Caps Lock key" '' '|Caps Lock' 'ctrl:nocaps|another Ctrl' 'caps:escape|Escape' \
		'caps:swapescape|swap with Escape' 'caps:backspace|Backspace' 'caps:none|nothing'
}
s_kb_compose() {
	choose kb_compose "Compose key (é = Compose ' e)" '' '|none' 'compose:ralt|Right Alt' 'compose:menu|Menu key' \
		'compose:rctrl|Right Ctrl' 'compose:caps|Caps Lock'
}
s_kb_rate() { choose repeat_rate "Key repeat speed" 40 '25|slow' '40|normal' '55|fast' '70|very fast'; }
s_kb_delay() { choose repeat_delay "Key repeat delay" 250 '180|short' '250|normal' '400|long' '600|very long'; }
s_kb_numlock() { choose numlock "Num Lock at start" disabled 'enabled|on' 'disabled|off'; }
s_keybindings() {
	local f=$CFG/sway/config.d/90-local.conf
	[ -f "$f" ] || printf '# Your own sway binds and overrides. Gitignored, per machine.\n# vim-style focus:\n# bindsym $mod+h focus left\n# bindsym $mod+j focus down\n# bindsym $mod+k focus up\n# bindsym $mod+l focus right\n' >"$f"
	exec foot -e "${EDITOR:-nvim}" "$f"
}

# ---- mouse and touchpad

s_mouse() {
	submenu "Mouse & touchpad" \
		'Mouse speed|s_mouse_speed' 'Mouse acceleration|s_mouse_accel' 'Mouse natural scrolling|s_mouse_natural' \
		'Touchpad speed|s_tp_speed' 'Touchpad natural scrolling|s_tp_natural' 'Tap to click|s_tp_tap' \
		'Touchpad scroll speed|s_tp_scroll' 'Ignore touchpad while typing|s_tp_dwt' 'Right click|s_tp_click' \
		'Touchpad on / off|s_tp_events' 'Touchscreen on / off|s_touchscreen'
}
speeds() { printf '%s\n' '-0.6|slowest' '-0.3|slower' '0|normal' '0.3|faster' '0.6|fastest'; }
s_mouse_speed() { mapfile -t o < <(speeds); choose mouse_speed "Mouse speed" 0 "${o[@]}"; }
s_tp_speed() { mapfile -t o < <(speeds); choose touchpad_speed "Touchpad speed" 0 "${o[@]}"; }
s_mouse_accel() { choose mouse_accel "Mouse acceleration" adaptive 'adaptive|on (faster moves go further)' 'flat|off (1:1, for games and design)'; }
s_mouse_natural() { choose mouse_natural "Mouse wheel" disabled 'disabled|classic' 'enabled|natural (content follows the wheel)'; }
s_tp_natural() { choose natural_scroll "Touchpad scrolling" enabled 'enabled|natural (like a phone)' 'disabled|classic'; }
s_tp_tap() { choose tap "Tap to click" enabled 'enabled|on' 'disabled|off'; }
s_tp_scroll() { choose scroll_factor "Touchpad scroll speed" 1 '0.4|slow' '0.7|calm' '1|normal' '1.5|fast' '2|very fast'; }
s_tp_dwt() { choose dwt "Ignore the touchpad while typing" enabled 'enabled|yes' 'disabled|no'; }
s_tp_click() { choose click_method "Right click on the touchpad" clickfinger 'clickfinger|two-finger click' 'button_areas|bottom-right corner'; }
s_tp_events() { choose touchpad "Touchpad" enabled 'enabled|on' 'disabled_on_external_mouse|off while a mouse is plugged in' 'disabled|off'; }
s_touchscreen() { choose touchscreen "Touchscreen" enabled 'enabled|on' 'disabled|off'; }

# ---- idle and lock

s_idle() {
	submenu "Idle & lock" 'Screensaver after|s_idle_saver' 'Lock after|s_idle_lock' 'Screen off after|s_idle_off' \
		'Screensaver text|s_saver_text' 'Keep awake now|toggle idle'
}
s_idle_saver() { choose idle_saver "Screensaver after" 240 '120|2 minutes' '240|4 minutes' '600|10 minutes' '0|never' && idle_start; }
s_idle_lock() { choose idle_lock "Lock after" 300 '180|3 minutes' '300|5 minutes' '600|10 minutes' '1800|30 minutes' '0|never' && idle_start; }
s_idle_off() { choose idle_off "Screen off after" 600 '300|5 minutes' '600|10 minutes' '1200|20 minutes' '0|never' && idle_start; }
s_saver_text() {
	local t
	t=$(ask_text "Screensaver text (empty = rayconfig)") || return 0
	set_ saver_text "$t"
}

# ---- display and windows

s_display() {
	local out what choice
	out=$(swaymsg -t get_outputs -p | sed -n 's/^Output \([^ ]*\).*/\1/p' | pick "Display" 5) || return 0
	what=$(printf 'scale\nresolution\nposition\nrotate\non / off\n' | pick "$out" 5) || return 0
	case $what in
	scale)
		choice=$(printf '1\n1.25\n1.5\n1.75\n2\n' | pick "Scale" 5) || return 0
		set_ "output_${out}__scale" "$choice"
		;;
	resolution)
		choice=$(swaymsg -t get_outputs -p | awk -v o="$out" '
			/^Output / { cur = $2 } cur == o && /Hz/ { gsub(/^ +/, ""); print }' | sort -u | pick "Resolution" 12) || return 0
		set_ "output_${out}__mode" "$(printf '%s' "$choice" | awk '{print $1 "@" $3 "Hz"}')"
		;;
	position)
		choice=$(printf 'left of the others\nright of the others\nabove the others\nbelow the others\n' | pick "Place $out" 4) || return 0
		local w h
		w=$(swaymsg -t get_outputs -p | awk -v o="$out" '/^Output / { cur = $2 } cur != o && /Current mode:/ { split($3, a, "x"); print a[1]; exit }')
		h=$(swaymsg -t get_outputs -p | awk -v o="$out" '/^Output / { cur = $2 } cur != o && /Current mode:/ { split($3, a, "x"); print a[2]; exit }')
		case $choice in
		left*) set_ "output_${out}__position" "-${w:-1920} 0" ;;
		right*) set_ "output_${out}__position" "${w:-1920} 0" ;;
		above*) set_ "output_${out}__position" "0 -${h:-1080}" ;;
		below*) set_ "output_${out}__position" "0 ${h:-1080}" ;;
		esac
		;;
	rotate)
		choice=$(printf 'normal\n90\n180\n270\n' | pick "Rotate $out" 4) || return 0
		set_ "output_${out}__transform" "$choice"
		;;
	'on / off')
		swaymsg output "$out" toggle >/dev/null
		return 0
		;;
	esac
	note "Display" "$out: $what $choice"
}
s_windows() {
	submenu "Windows" 'Gaps|s_gaps' 'Borders|s_border' 'Focus follows mouse|s_focus' \
		'New workspaces open as|s_wslayout' 'Terminal transparency|s_alpha' 'This window: see-through on / off|toggle opacity'
}
s_gaps() { choose gaps "Gaps between windows" 8 '0|none' '4|small' '8|medium' '14|large' '22|huge'; }
s_border() { choose border "Window borders" 2 '0|none' '1|thin' '2|normal' '3|thick' 'title|title bars'; }
s_focus() { choose focus_follows_mouse "Focus follows the mouse" yes 'yes|yes' 'no|no, click to focus'; }
s_wslayout() { choose workspace_layout "New workspaces open as" default 'default|tiles' 'tabbed|tabs' 'stacking|a stack'; }
s_alpha() {
	choose term_alpha "Terminal transparency" 0.96 '1.0|opaque' '0.96|a touch' '0.9|light' '0.8|strong' || return 0
	"$ROOT/bin/gen-theme" "$(cat "$STATE/theme" 2>/dev/null || echo sunset)" >/dev/null
	note "Terminal" "new terminal windows use it"
}

# ---- bar

s_bar() {
	submenu "Bar" 'Position|s_bar_pos' 'Background|s_bar_bg' 'Clock|s_bar_clock' 'Battery percentage|s_bar_bat' \
		'CPU load|s_bar_cpu' 'Show / hide now|toggle bar'
}
s_bar_pos() { choose bar_position "Bar position" top 'top|top' 'bottom|bottom'; }
s_bar_bg() { choose bar_background "Bar background" opaque 'opaque|solid' 'clear|clear (wallpaper shows through)'; }
s_bar_clock() {
	choose clock_format "Clock" '%a %d %b  %H:%M' \
		"%a %d %b  %H:%M|$(date '+%a %d %b  %H:%M')" "%A %H:%M|$(date '+%A %H:%M')" "%H:%M|$(date '+%H:%M')" \
		"%I:%M %p|$(date '+%I:%M %p')" "%a %d %b  %I:%M %p|$(date '+%a %d %b  %I:%M %p')" \
		"%H:%M:%S|$(date '+%H:%M:%S')" "%Y-%m-%d %H:%M|$(date '+%Y-%m-%d %H:%M')" "%d %b W%V %Y|$(date '+%d %b W%V %Y')"
}
s_bar_bat() { choose bar_battery "Battery in the bar" on 'on|percentage' 'off|only when low'; }
s_bar_cpu() { choose bar_cpu "CPU load in the bar" on 'on|show' 'off|hide'; }

# ---- night light

s_nightlight() {
	submenu "Night light ($(onoff flag nightlight))" 'On / off|t_nightlight' 'Warmth|s_nl_temp' 'Schedule|s_nl_sched'
}
nightlight_start() {
	local s
	s=$(get nl_schedule || echo '19:30-07:00')
	pkill -x wlsunset 2>/dev/null || true
	setsid -f wlsunset -t "$(get nl_temp || echo 3800)" -s "${s%-*}" -S "${s#*-}" >/dev/null 2>&1
}
t_nightlight() {
	have wlsunset || { note "Night light" "wlsunset is not installed — run ray update"; return 0; }
	if pkill -x wlsunset; then
		set_ nightlight off
		flag_clear nightlight
		note "Night light" "off"
	else
		set_ nightlight on
		flag_set nightlight
		nightlight_start
		note "Night light" "on ($(get nl_schedule || echo '19:30-07:00'), $(get nl_temp || echo 3800)K)"
	fi
}
s_nl_temp() { choose nl_temp "Night light warmth" 3800 '4500|subtle' '3800|warm' '3200|warmer' '2700|candle' && flag nightlight && nightlight_start; }
s_nl_sched() {
	choose nl_schedule "Night light schedule (on at, off at)" '19:30-07:00' '18:00-07:00|18:00 to 07:00' \
		'19:30-07:00|19:30 to 07:00' '21:00-06:30|21:00 to 06:30' '22:30-07:30|22:30 to 07:30' && flag nightlight && nightlight_start
}

# ---- region

s_region() { submenu "Region" 'Timezone|s_timezone' 'Language|s_language' 'Formats (dates, numbers)|s_formats' 'Sync the clock now|s_timesync'; }
s_timezone() {
	local z
	z=$(timedatectl list-timezones | pick "Timezone ($(timedatectl show -p Timezone --value 2>/dev/null))" 15) || return 0
	float_sh "timedatectl set-timezone '$z' && echo 'Timezone: $z'"
}
locales() { sed -n 's/^#\{0,1\}\([a-z][a-z_A-Z]*\.UTF-8\) UTF-8.*/\1/p' /etc/locale.gen 2>/dev/null | sort -u; }
locale_script() { # var locale
	printf "grep -q '^%s UTF-8' /etc/locale.gen || { sudo sed -i 's/^#%s UTF-8/%s UTF-8/' /etc/locale.gen && sudo locale-gen; } && sudo localectl set-locale %s && echo 'Set %s. Log out and in to see it everywhere.'" \
		"$2" "$2" "$2" "$1=$2" "$1=$2"
}
s_language() {
	local l
	l=$(locales | pick "Language ($(localectl status | sed -n 's/.*LANG=//p'))" 15) || return 0
	float_sh "$(locale_script LANG "$l")"
}
s_formats() {
	local l
	l=$(locales | pick "Formats for dates, numbers, money, paper" 15) || return 0
	float_sh "$(locale_script LC_TIME "$l") && sudo localectl set-locale LANG=\$(localectl status | sed -n 's/.*LANG=//p') LC_TIME=$l LC_NUMERIC=$l LC_MONETARY=$l LC_PAPER=$l LC_MEASUREMENT=$l"
}
s_timesync() { float_sh "sudo timedatectl set-ntp true && sudo systemctl restart systemd-timesyncd && sleep 2 && timedatectl status"; }

# ---- network

s_network() {
	submenu "Network" 'Wi-Fi|s_wifi' 'DNS|s_dns' 'Computer name|s_hostname' 'Share Wi-Fi as a QR code|s_wifiqr' \
		'Speed test|s_speedtest'
}
s_dns() {
	have nmcli || { note "DNS" "NetworkManager is not installed"; return 0; }
	local con c dns
	con=$(nmcli -t -f NAME connection show --active | head -n1)
	[ -n "$con" ] || { note "DNS" "no active connection"; return 0; }
	c=$(printf '%s\n' 'Automatic (from the network)' 'Cloudflare 1.1.1.1' 'Quad9 9.9.9.9' 'Google 8.8.8.8' 'Custom…' | pick "DNS for $con" 5) || return 0
	case $c in
	Automatic*) dns='' ;;
	Cloudflare*) dns='1.1.1.1 1.0.0.1' ;;
	Quad9*) dns='9.9.9.9 149.112.112.112' ;;
	Google*) dns='8.8.8.8 8.8.4.4' ;;
	Custom*) dns=$(ask_text "DNS servers, space separated") || return 0 ;;
	esac
	if [ -z "$dns" ]; then
		nmcli connection modify "$con" ipv4.dns '' ipv4.ignore-auto-dns no
	else
		nmcli connection modify "$con" ipv4.dns "$dns" ipv4.ignore-auto-dns yes
	fi
	nmcli connection up "$con" >/dev/null 2>&1 || true
	note "DNS" "$con: ${dns:-automatic}"
}
s_hostname() {
	local n
	n=$(ask_text "Computer name ($(hostnamectl hostname 2>/dev/null || cat /etc/hostname))") || return 0
	printf '%s' "$n" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$' || { note "Computer name" "letters, digits and - only"; return 0; }
	float_sh "sudo hostnamectl set-hostname '$n' && echo 'Computer name: $n'"
}
s_wifiqr() { float_sh "nmcli device wifi show-password"; }
s_speedtest() {
	if have speedtest-cli; then float_sh "speedtest-cli --simple"; else float_sh "echo 'Download speed (10 MB from a CDN):'; curl -o /dev/null -w '%{speed_download}\n' -sS https://speed.cloudflare.com/__down?bytes=10000000 | awk '{printf \"%.1f Mbit/s\n\", \$1 * 8 / 1000000}'"; fi
}

# ---- security

s_security() {
	submenu "Security" 'Fingerprint login|s_fingerprint' 'Security key (FIDO2)|s_fido2' 'SSH server|s_sshd' \
		'SSH agent|s_sshagent' 'sudo without a password|s_nopasswd' 'Autologin|s_autologin' 'Password|s_password'
}
s_password() { tui "Password" passwd; }
pam_add() { # module — add "auth sufficient <module>" to sudo and swaylock
	printf "for f in /etc/pam.d/sudo /etc/pam.d/swaylock; do [ -f \"\$f\" ] || continue; grep -q '%s' \"\$f\" || sudo sed -i '1a auth sufficient %s' \"\$f\"; echo \"  \$f: %s accepted\"; done" "$1" "$1" "$1"
}
s_fingerprint() {
	float_sh "set -e
echo 'Fingerprint: installs fprintd, enrolls a finger, and lets sudo and the'
echo 'lock screen accept it (the password keeps working). Ctrl+C to stop.'
sudo pacman -S --needed --noconfirm fprintd
fprintd-enroll
$(pam_add pam_fprintd.so)"
}
s_fido2() {
	float_sh "set -e
echo 'Security key: installs pam-u2f, registers your key (touch it when it blinks),'
echo 'and lets sudo and the lock screen accept it. The password keeps working.'
sudo pacman -S --needed --noconfirm pam-u2f
mkdir -p ~/.config/Yubico
pamu2fcfg >> ~/.config/Yubico/u2f_keys
$(pam_add pam_u2f.so)"
}
s_sshd() {
	if systemctl is-active -q sshd 2>/dev/null; then
		confirm "The SSH server is running. Stop it?" && float_sh "sudo systemctl disable --now sshd && echo 'SSH server off.'"
	else
		confirm "Start an SSH server so other machines can log in here?" &&
			float_sh "sudo pacman -S --needed --noconfirm openssh && sudo systemctl enable --now sshd && echo 'SSH server on: ssh $USER@$(hostnamectl hostname 2>/dev/null)'"
	fi
}
s_sshagent() {
	float_sh "sudo pacman -S --needed --noconfirm openssh && systemctl --user enable --now ssh-agent.service && echo 'SSH agent on. New shells use it (dots/shell/rc.sh sets SSH_AUTH_SOCK).'"
}
s_nopasswd() {
	local f=/etc/sudoers.d/20-rayconfig-nopasswd
	if [ -f "$f" ]; then
		confirm "sudo asks for no password now. Ask again?" && float_sh "sudo rm -f '$f' && echo 'sudo asks for your password again.'"
	else
		confirm "Let $USER use sudo without a password? Anything you run could change the system silently." || return 0
		float_sh "printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' '$USER' | sudo tee '$f.tmp' >/dev/null && sudo visudo -cf '$f.tmp' && sudo install -m440 '$f.tmp' '$f' && sudo rm -f '$f.tmp' && echo 'Done.'"
	fi
}
# Log straight in on tty1 (disk encryption, if any, still asks first).
s_autologin() {
	local d=/etc/systemd/system/getty@tty1.service.d tmp
	if [ -f "$d/autologin.conf" ]; then
		confirm "Autologin is on. Turn it off?" || return 0
		float_sh "sudo rm -f '$d/autologin.conf' && echo 'Autologin off.'"
	else
		confirm "Log in automatically on tty1 (no password at boot)?" || return 0
		tmp=$(mktemp)
		cat >"$tmp" <<EOT
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --autologin $USER %I \$TERM
EOT
		float_sh "sudo install -Dm644 '$tmp' '$d/autologin.conf' && rm -f '$tmp' && echo 'Autologin on for $USER.'"
	fi
}

# ---- defaults and identity

s_defaults_menu() { submenu "Defaults" 'Apps for each file type|s_defaults' 'Web browser|s_browser' 'Editor|s_editor'; }
s_defaults() {
	defaults
	note "Default apps" "folders → muhfm, text → solarvim, images → imv, video → mpv, PDF → zathura (where installed). Change one: o then Ctrl+D in muhfm."
}
s_browser() {
	local ids b
	ids=$(for b in chromium firefox brave-browser google-chrome vivaldi-stable librewolf microsoft-edge; do
		[ -f "/usr/share/applications/$b.desktop" ] && echo "$b"
	done)
	[ -n "$ids" ] || { note "Browser" "none installed — Install → Browser"; return 0; }
	b=$(printf '%s\n' "$ids" | pick "Web browser ($(xdg-settings get default-web-browser 2>/dev/null | sed 's/\.desktop//'))" 7) || return 0
	xdg-settings set default-web-browser "$b.desktop" && note "Web browser" "$b"
}
s_editor() {
	local e
	e=$(for e in 'env NVIM_APPNAME=solarvim nvim|solarvim' 'nvim|neovim' 'helix|helix' 'vim|vim' 'nano|nano' 'emacs -nw|emacs'; do
		have "${e%%|*}" || have "$(printf '%s' "${e%%|*}" | awk '{print $NF}')" && printf '%s\n' "${e#*|}"
	done | pick "Editor (muhfm, ray edit, git)" 6) || return 0
	case $e in solarvim) e='env NVIM_APPNAME=solarvim nvim' ;; neovim) e=nvim ;; emacs) e='emacs -nw' ;; esac
	set_ editor "$e"
	mkdir -p "$CFG/environment.d"
	printf '# generated by ray: Settings → Defaults → Editor\nEDITOR=%s\nVISUAL=%s\n' "$e" "$e" >"$CFG/environment.d/60-rayconfig-editor.conf"
	note "Editor" "$e — new shells and muhfm use it"
}
s_git() {
	local n m
	n=$(ask_text "Your name for git commits ($(git config --global user.name 2>/dev/null))") || return 0
	m=$(ask_text "Your email for git commits ($(git config --global user.email 2>/dev/null))") || return 0
	[ -n "$n" ] && git config --global user.name "$n"
	[ -n "$m" ] && git config --global user.email "$m"
	git config --global init.defaultBranch main
	git config --global pull.ff only
	note "Git" "${n:-unchanged} <${m:-unchanged}>"
}
s_config() {
	submenu "Edit a config" 'sway|ray_edit sway' 'my keybindings (90-local)|ray_edit local' 'terminal (foot)|ray_edit foot' \
		'notifications (mako)|ray_edit mako' 'launcher (fuzzel)|ray_edit fuzzel' 'files (muhfm)|ray_edit muhfm' \
		'this theme palette|ray_edit theme' 'settings state|ray_edit settings' 'editor (solarvim)|ray_edit vim'
}
ray_edit() { exec foot -e "$ROOT/bin/ray" edit "$1"; }

settings() {
	case ${1:-} in '') ;; *) "s_$1"; return ;; esac
	submenu "Settings" \
		'Wi-Fi|s_wifi' 'Bluetooth|s_bluetooth' 'Sound|s_sound' 'Display|s_display' 'Keyboard|s_keyboard' \
		'Mouse & touchpad|s_mouse' 'Idle & lock|s_idle' 'Night light|s_nightlight' 'Power profile|s_power' \
		'Appearance|menu_style' 'Region & time|s_region' 'Network|s_network' 'Security|s_security' \
		'Defaults|s_defaults_menu' 'Git name & email|s_git' 'Edit a config|s_config' \
		'Updates|menu_update' 'System monitor|s_monitor' 'Ask an agent|ask'
}
s_monitor() { if have btop; then tui "System" btop; else tui "System" top; fi; }
s_power() {
	have powerprofilesctl || { note "Power" "power-profiles-daemon is not installed — run ray update"; return 0; }
	local p
	p=$(powerprofilesctl list | sed -n 's/^[* ] *\([a-z-]*\):$/\1/p' | pick "Power profile ($(powerprofilesctl get))" 3) || return 0
	powerprofilesctl set "$p" && note "Power" "$p"
}

# ---------------------------------------------------------------- toggles

# swayidle, run by ray so it can be paused: screensaver, lock, screen off.
idle_start() {
	pkill -x swayidle 2>/dev/null || true
	flag_clear awake
	local saver lock off args=()
	saver=$(get idle_saver || echo 240) lock=$(get idle_lock || echo 300) off=$(get idle_off || echo 600)
	saver=${saver:-240} lock=${lock:-300} off=${off:-600}
	[ "$saver" -gt 0 ] && [ "$(get screensaver || echo on)" != off ] &&
		args+=(timeout "$saver" "$ROOT/bin/ray screensaver" resume "$ROOT/bin/ray screensaver stop")
	[ "$lock" -gt 0 ] && args+=(timeout "$lock" 'swaylock -f')
	[ "$off" -gt 0 ] && args+=(timeout "$off" 'swaymsg "output * power off"' resume 'swaymsg "output * power on"')
	setsid -f swayidle -w "${args[@]}" before-sleep 'swaylock -f' >/dev/null 2>&1
}

toggle() {
	case ${1:-} in
	nightlight) t_nightlight ;;
	idle | awake)
		if pgrep -x swayidle >/dev/null; then
			pkill -x swayidle
			flag_set awake
			note "Keep awake" "on — no lock, no screen off. Super+Ctrl+I to undo."
		else
			idle_start
			note "Keep awake" "off — locks after 5 minutes again"
		fi
		;;
	dnd)
		have makoctl || return 0
		makoctl mode -t do-not-disturb >/dev/null
		if makoctl mode | grep -q do-not-disturb; then flag_set dnd; else
			flag_clear dnd
			note "Do not disturb" "off"
		fi
		;;
	bar) swaymsg bar mode toggle >/dev/null ;;
	gaps)
		if flag nogaps; then
			flag_clear nogaps
			swaymsg 'gaps inner all set 8, gaps outer all set 4' >/dev/null
		else
			flag_set nogaps
			swaymsg 'gaps inner all set 0, gaps outer all set 0' >/dev/null
		fi
		;;
	opacity)
		if flag opaque; then
			flag_clear opaque
			swaymsg opacity 0.92 >/dev/null
		else
			flag_set opaque
			swaymsg opacity 1 >/dev/null
		fi
		;;
	screensaver)
		if [ "$(get screensaver || echo on)" = off ]; then set_ screensaver on; else set_ screensaver off; fi
		idle_start
		note "Screensaver" "$(get screensaver)"
		;;
	*)
		echo "usage: ray toggle nightlight|idle|dnd|bar|gaps|opacity|screensaver" >&2
		return 2
		;;
	esac
}

# ---------------------------------------------------------------- screensaver

# A fullscreen foot window drawing the sun drifting around in theme colours.
# Any key closes it; swayidle closes it on mouse movement.
screensaver() {
	case ${1:-} in
	stop)
		pkill -f 'app-id ray-screensaver' 2>/dev/null || true
		return 0
		;;
	esac
	pgrep -f 'app-id ray-screensaver' >/dev/null && return 0
	setsid -f foot --app-id ray-screensaver "$ROOT/bin/ray" _saver >/dev/null 2>&1
}
saver() {
	local cols rows x=3 y=2 dx=1 dy=1 c=0 k
	local text
	text=$(get saver_text || true)
	local art=('    \ | /    ' '  ‒‒ ☀ ‒‒   ' '    / | \    ' '' "  ${text:-rayconfig}  ")
	trap 'printf "\033[?25h\033[0m"; clear' EXIT
	printf '\033[?25l'
	while :; do
		cols=$(tput cols) rows=$(tput lines)
		printf '\033[2J'
		local i
		for i in "${!art[@]}"; do
			printf '\033[%d;%dH\033[%dm%s' $((y + i)) "$x" $((31 + c % 6)) "${art[$i]}"
		done
		x=$((x + dx)) y=$((y + dy))
		[ "$x" -le 1 ] || [ "$x" -ge $((cols - ${#art[4]} - 1)) ] && { dx=$((-dx)); c=$((c + 1)); }
		[ "$y" -le 1 ] || [ "$y" -ge $((rows - 5)) ] && { dy=$((-dy)); c=$((c + 1)); }
		if IFS= read -rsn1 -t 0.12 k; then break; fi
	done
	: "${k:-}"
}

# ---------------------------------------------------------------- pickers: clipboard, emoji, apps

clipboard() {
	have cliphist || { note "Clipboard" "cliphist is not installed — run ray update"; return 0; }
	local c
	c=$(cliphist list | pick "Clipboard history" 15) || return 0
	printf '%s' "$c" | cliphist decode | wl-copy
}

emoji() {
	local e
	e=$(grep -v '^#' "$ROOT/data/emoji.txt" | pick "Emoji" 15) || return 0
	printf '%s' "${e%% *}" | wl-copy -n
	note "Emoji" "${e%% *} copied — paste with Ctrl+V"
}

browser() {
	local b
	for b in ${BROWSER:-} chromium brave firefox librewolf google-chrome-stable vivaldi-stable; do
		have "$b" && exec "$b" "$@"
	done
	note "Browser" "no browser installed — Super+Alt+Space → Install → Package (chromium or firefox)"
}

# ---------------------------------------------------------------- web apps

# A web app is a desktop entry that opens a site in its own app window.
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'; }
webapp() {
	local sub=${1:-} name url b exec_line f
	case $sub in
	add)
		name=${2:-$(ask_text "Web app name")} || return 0
		url=${3:-$(ask_text "Address (https://…)")} || return 0
		[ -n "$name" ] && [ -n "$url" ] || return 0
		case $url in http*://*) ;; *) url="https://$url" ;; esac
		exec_line="xdg-open $url"
		for b in chromium brave google-chrome-stable vivaldi-stable; do
			if have "$b"; then exec_line="$b --app=$url"; break; fi
		done
		mkdir -p "$APPS"
		f="$APPS/ray-webapp-$(slug "$name").desktop"
		cat >"$f" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=Web app: $url
Exec=$exec_line
Icon=web-browser
Categories=Network;WebApp;
X-Rayconfig-WebApp=$url
EOF
		note "Web app" "$name is in the launcher (Super+D)"
		;;
	remove)
		name=$(grep -l '^X-Rayconfig-WebApp=' "$APPS"/ray-webapp-*.desktop 2>/dev/null |
			xargs -r -n1 sed -n 's/^Name=//p' | pick "Remove web app" 10) || return 0
		rm -f "$APPS/ray-webapp-$(slug "$name").desktop"
		note "Web app" "$name removed"
		;;
	list) grep -H '^X-Rayconfig-WebApp=' "$APPS"/ray-webapp-*.desktop 2>/dev/null | sed 's|.*/ray-webapp-||; s|\.desktop:X-Rayconfig-WebApp=|  |' ;;
	*) echo "usage: ray webapp add [NAME URL] | remove | list" >&2; return 2 ;;
	esac
}

# ---------------------------------------------------------------- packages

install_pkg() {
	local p=${1:-}
	[ -n "$p" ] || p=$(pacman -Slq | sort -u | pick "Install (official repos)" 15) || return 0
	float_sh "sudo pacman -S --needed '$p'"
}
install_font() {
	local p
	p=$(pacman -Slq | grep -E '^(ttf|otf)-' | sort -u | pick "Install font" 15) || return 0
	float_sh "sudo pacman -S --needed '$p' && fc-cache -f && echo 'Now: Appearance → Font'"
}
remove_pkg() {
	local p=${1:-}
	[ -n "$p" ] || p=$(pacman -Qeq | pick "Remove package" 15) || return 0
	float_sh "sudo pacman -Rns '$p'"
}

# ---------------------------------------------------------------- boot splash

asroot() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }

# Install the palette's plymouth theme, make sure the initramfs runs plymouth
# and the kernel is told `splash`, then rebuild the initramfs — each step only
# if it is not already so. Safe to run any number of times.
splash() {
	local src=$STATE/plymouth dst=/usr/share/plymouth/themes/rayconfig
	local conf=/etc/mkinitcpio.conf changed=0 f
	have plymouth-set-default-theme || { echo "splash: plymouth is not installed (sudo pacman -S plymouth)" >&2; return 1; }
	[ -f "$src/rayconfig.script" ] || "$ROOT/bin/gen-theme" >/dev/null
	for f in rayconfig.plymouth rayconfig.script; do
		if ! cmp -s "$src/$f" "$dst/$f"; then
			asroot install -Dm644 "$src/$f" "$dst/$f"
			changed=1
		fi
	done
	if [ "$(plymouth-set-default-theme 2>/dev/null)" != rayconfig ]; then
		asroot plymouth-set-default-theme rayconfig
		changed=1
	fi
	echo "  theme: rayconfig ($(cat "$STATE/theme" 2>/dev/null || echo sunset))"

	# initramfs hook: plymouth goes right after udev/systemd (before sd-encrypt,
	# so it can ask for the disk password)
	if [ -f "$conf" ] && ! grep -qE '^HOOKS=.*[( ]plymouth[ )]' "$conf"; then
		[ -f "$conf.rayconfig-bak" ] || asroot cp "$conf" "$conf.rayconfig-bak"
		if grep -qE '^HOOKS=.*[( ]systemd[ )]' "$conf"; then
			asroot sed -i -E '/^HOOKS=/ s/([( ])systemd([ )])/\1systemd plymouth\2/' "$conf"
		elif grep -qE '^HOOKS=.*[( ]udev[ )]' "$conf"; then
			asroot sed -i -E '/^HOOKS=/ s/([( ])udev([ )])/\1udev plymouth\2/' "$conf"
		else
			echo "  add plymouth to HOOKS in $conf by hand (after udev or systemd)" >&2
		fi
		changed=1
		echo "  $conf: plymouth hook added (backup: $conf.rayconfig-bak)"
	fi

	# kernel command line: `quiet splash` on systemd-boot entries or GRUB
	for f in /boot/loader/entries/*.conf; do
		[ -f "$f" ] || continue
		grep -q '^options' "$f" || continue
		grep -qE '^options.*\bsplash\b' "$f" || { asroot sed -i '/^options/ s/$/ splash/' "$f"; echo "  $f: + splash"; }
		grep -qE '^options.*\bquiet\b' "$f" || asroot sed -i '/^options/ s/$/ quiet/' "$f"
	done
	if [ -f /etc/default/grub ] && ! grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=.*\bsplash\b' /etc/default/grub; then
		asroot sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=")/\1splash /' /etc/default/grub
		have grub-mkconfig && asroot grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
		echo "  /etc/default/grub: + splash"
	fi

	if [ "$changed" = 1 ]; then
		echo "  rebuilding the initramfs…"
		asroot mkinitcpio -P >/dev/null
	fi
	echo "  boot splash ready — you will see it on the next boot"
}

# ---------------------------------------------------------------- default apps

# Point common types at the apps Rayconfig ships, but never over a choice the
# user made in ~/.config/mimeapps.list (muhfm: o, then Ctrl+D).
defaults() {
	have xdg-mime || return 0
	mkdir -p "$APPS"
	cat >"$APPS/solarvim.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=solarvim
GenericName=Text Editor
Comment=Neovim with the Rayconfig palette
Exec=env NVIM_APPNAME=solarvim nvim %F
Terminal=true
Icon=nvim
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-shellscript;application/x-shellscript;text/x-python;text/x-csrc;text/x-chdr;text/x-c++src;text/x-go;text/x-lua;text/x-rust;application/json;application/toml;application/x-yaml;text/x-log;
EOF
	local user=$CFG/mimeapps.list
	setdef() { # desktop-id mime...
		local d=$1 m cur
		shift
		[ -f "$APPS/$d" ] || [ -f "/usr/share/applications/$d" ] || return 0
		for m; do
			cur=$(sed -n "s|^$m=\([^;]*\).*|\1|p" "$user" 2>/dev/null | head -n1)
			case $cur in '' | "$d") xdg-mime default "$d" "$m" ;; esac
		done
	}
	setdef muhfm.desktop inode/directory
	setdef solarvim.desktop text/plain text/markdown text/x-shellscript application/x-shellscript \
		text/x-python text/x-csrc text/x-chdr text/x-go text/x-lua application/json application/toml application/x-yaml
	setdef imv.desktop image/png image/jpeg image/gif image/webp image/bmp image/tiff image/svg+xml
	setdef mpv.desktop video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo \
		audio/mpeg audio/flac audio/ogg audio/x-wav audio/mp4 audio/opus
	setdef org.pwmt.zathura.desktop application/pdf application/epub+zip
}

# ---------------------------------------------------------------- agent

# An agent works best inside the repo: CLAUDE.md there explains the ethos,
# the layout and how to verify. Use Claude Code if installed, else the web.
ask() {
	if have claude; then
		cd "$ROOT" && exec foot --title "agent · rayconfig" claude
	fi
	note "Ask an agent" "Claude Code is not installed; opening the web app. Install: curl -fsSL https://claude.ai/install.sh | bash"
	exec xdg-open "https://claude.ai/code"
}

# ---------------------------------------------------------------- update

pull() { # dir name
	[ -d "$1/.git" ] || { printf '  %s: not a git checkout, skipped\n' "$2"; return 0; }
	local before after
	before=$(git -C "$1" rev-parse --short HEAD)
	if git -C "$1" pull --quiet --ff-only; then
		after=$(git -C "$1" rev-parse --short HEAD)
		if [ "$before" = "$after" ]; then
			printf '  %s: up to date (%s)\n' "$2" "$after"
		else
			printf '  %s: %s → %s\n' "$2" "$before" "$after"
			git -C "$1" log --oneline "$before..$after" | sed 's/^/    /'
		fi
	else
		printf '  %s%s: local changes, not fast-forwarded — kept as-is%s\n' "$R" "$2" "$Z"
	fi
}

# Pull first, then hand over to the *new* code, so an update can change how
# updating works and still lands in one run. No reinstall, ever.
update() {
	step "rayconfig"
	pull "$ROOT" rayconfig
	step "solarvim"
	pull "$SV" solarvim
	step "muhfm"
	pull "$MF" muhfm
	exec "$ROOT/bin/ray" _update_rest
}
update_rest() {
	step "Arch packages + anything new in the package lists"
	"$ROOT/bootstrap/install.sh" --only packages,link,solarvim,muhfm,theme --yes | grep -vE '^ ok ' || true
	render_settings
	step "check"
	if "$ROOT/bin/doctor" >/dev/null 2>&1; then
		printf '  %sall good%s\n' "$G" "$Z"
	else
		printf '  %sproblems found — run: ray doctor%s\n' "$R" "$Z"
	fi
	: >"$STATE/updates" 2>/dev/null || true
	if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
		printf '\n  %sthe kernel was updated — reboot when convenient%s\n' "$H" "$Z"
	fi
	note "System updated" "Everything is current."
}
# Restart the long-running pieces without logging out.
restart() {
	have makoctl && { makoctl reload 2>/dev/null || { pkill -x mako; setsid -f mako; }; }
	idle_start
	pkill -f 'wl-paste --watch cliphist' 2>/dev/null || true
	if have cliphist; then
		setsid -f wl-paste --watch cliphist store >/dev/null 2>&1
		setsid -f wl-paste --type image --watch cliphist store >/dev/null 2>&1
	fi
	in_sway && swaymsg reload >/dev/null # restarts the bar too
	note "Restarted" "notifications, idle, clipboard history, bar"
}

