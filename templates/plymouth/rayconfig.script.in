# Rayconfig boot splash — generated by `ray theme` from themes/@theme@/palette.
# Edit templates/plymouth/rayconfig.script.in, then: ray splash
# Plymouth script: a pulsing wordmark, the disk password prompt, boot messages.
# Colours are 0..1 floats from the palette; text only, no image files.
# Only characters every Latin font has: the initramfs carries one font, so a
# symbol like a sun glyph could show up as an empty box.

Window.SetBackgroundTopColor(@bg_rgb@);
Window.SetBackgroundBottomColor(@bg2_rgb@);

sun = Image.Text("rayconfig", @sun_rgb@, 1, "Sans Bold 40");
sun_sprite = Sprite(sun);
name = Image.Text("— @theme@ —", @dim_rgb@, 1, "Sans 12");
name_sprite = Sprite(name);

fun centre_x(img) {
	return Window.GetX() + Window.GetWidth() / 2 - img.GetWidth() / 2;
}
mid_y = Window.GetY() + Window.GetHeight() / 2;

sun_sprite.SetPosition(centre_x(sun), mid_y - sun.GetHeight() / 2 - 30, 10);
name_sprite.SetPosition(centre_x(name), mid_y + sun.GetHeight() / 2 - 15, 10);

# a slow pulse, like the sun behind haze
tick = 0;
fun refresh() {
	tick = tick + 1;
	sun_sprite.SetOpacity(0.7 + 0.3 * Math.Sin(tick / 25));
}
Plymouth.SetRefreshFunction(refresh);

# disk password (LUKS): the prompt, then one dot per typed character
prompt_sprite = Sprite();
dots_sprite = Sprite();
fun display_password(prompt, bullets) {
	p = Image.Text(prompt, @fg_rgb@, 1, "Sans 12");
	s = "";
	i = 0;
	while (i < bullets) {
		s = s + "• ";
		i = i + 1;
	}
	if (bullets == 0) s = "_";
	d = Image.Text(s, @accent_rgb@, 1, "Sans 16");
	prompt_sprite.SetImage(p);
	dots_sprite.SetImage(d);
	prompt_sprite.SetPosition(centre_x(p), mid_y + 90, 20);
	dots_sprite.SetPosition(centre_x(d), mid_y + 125, 20);
	prompt_sprite.SetOpacity(1);
	dots_sprite.SetOpacity(1);
}
fun display_normal() {
	prompt_sprite.SetOpacity(0);
	dots_sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);

# boot messages (fsck and friends), small, at the bottom
msg_sprite = Sprite();
fun message(text) {
	m = Image.Text(text, @dim_rgb@, 1, "Sans 10");
	msg_sprite.SetImage(m);
	msg_sprite.SetPosition(centre_x(m), Window.GetY() + Window.GetHeight() - 50, 20);
}
Plymouth.SetMessageFunction(message);
