# Rayconfig — sway entry point. Files in config.d/ load in name order:
#   00-colors (generated)  10-defaults  20-inputs  30-binds  40-bar (generated)
#   90-local.conf is yours: gitignored, per machine.
include ~/.config/sway/config.d/*.conf

# Arch's sway package ships the systemd/dbus environment import here; without
# it portals (screen sharing, file pickers) and user services can't find sway.
include /etc/sway/config.d/*

# notifications
exec mako
# lock after 5 min, screen off after 10, always lock before sleep
exec swayidle -w \
	timeout 300 'swaylock -f' \
	timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
	before-sleep 'swaylock -f'
# night light if enabled, and a hello on first login
exec sh -c 'sleep 3; exec ~/.local/bin/ray startup'
