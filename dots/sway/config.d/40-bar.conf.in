# generated by `ray theme` — do not edit
bar {
	status_command ~/.local/bin/status
	position top
	height 30
	font pango:JetBrains Mono 10
	status_padding 6
	status_edge_padding 10
	workspace_min_width 30
	tray_padding 4
	workspace_buttons yes
	strip_workspace_numbers yes
	binding_mode_indicator yes

	colors {
		background @bg@
		statusline @fg@
		separator  @bg3@

		focused_workspace  @bg3@    @bg3@    @accent@
		active_workspace   @bg2@    @bg2@    @fg@
		inactive_workspace @bg@     @bg@     @dim@
		urgent_workspace   @urgent@ @urgent@ @bg@
		binding_mode       @bg3@    @bg3@    @sun@
	}
}
