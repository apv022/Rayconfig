# generated by `ray theme` — do not edit
bar {
	status_command ~/.local/bin/status
	position top
	height 26
	tray_output none
	workspace_buttons yes
	strip_workspace_numbers no
	binding_mode_indicator yes

	colors {
		background @bg@
		statusline @fg@
		separator  @bg3@

		focused_workspace  @accent@ @accent@ @bg@
		active_workspace   @bg3@    @bg3@    @fg@
		inactive_workspace @bg@     @bg@     @dim@
		urgent_workspace   @urgent@ @urgent@ @bg@
		binding_mode       @sun@    @sun@    @bg@
	}
}
