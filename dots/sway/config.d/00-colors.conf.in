# generated by `ray theme` for theme "@theme@" — do not edit
# edit themes/*/palette instead
set $bg      @bg@
set $bg2     @bg2@
set $bg3     @bg3@
set $fg      @fg@
set $dim     @dim@
set $accent  @accent@
set $urgent  @urgent@

# font: ray font (Super+I → Font) writes it to settings; rendered here
font pango:@font@ 9
