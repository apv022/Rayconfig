# generated by `ray theme` — edit themes/*/palette instead
color=@bg_hex@
font=JetBrains Mono
indicator-radius=90
indicator-thickness=8
show-failed-attempts
ignore-empty-password
inside-color=@bg2_hex@ee
ring-color=@accent_hex@
key-hl-color=@sun_hex@
bs-hl-color=@urgent_hex@
line-color=00000000
separator-color=00000000
text-color=@fg_hex@
inside-ver-color=@bg2_hex@ee
ring-ver-color=@sun_hex@
text-ver-color=@fg_hex@
inside-wrong-color=@bg2_hex@ee
ring-wrong-color=@urgent_hex@
text-wrong-color=@urgent_hex@
inside-clear-color=@bg2_hex@ee
ring-clear-color=@dim_hex@
text-clear-color=@fg_hex@
