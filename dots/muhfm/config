# muhfm — the file manager (Super+E). Plain key = value; every key optional.
# Colours come from foot, so muhfm follows the theme. `muhfm --help` lists keys.
terminal = foot
# the editor follows $EDITOR (Settings → Defaults → Editor), so it is not set here
preview = true
places = true
details = true
sort = name
dirs_first = true
hidden = false
icons = none
