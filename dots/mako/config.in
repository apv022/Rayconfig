# generated by `ray theme` — edit themes/*/palette instead
font=@font@ @font_size_small@

background-color=@bg2@f2
text-color=@fg@
border-color=@accent@
progress-color=over @bg3@ff

anchor=top-right
margin=10
padding=10
border-size=2
border-radius=8
width=380
height=140
max-visible=4
default-timeout=6000
ignore-timeout=0
layer=overlay

# critical notifications stay until dismissed
[urgency=critical]
border-color=@urgent@
default-timeout=0

# volume / brightness OSD (bin/vol, bin/bright): one bubble, replaced in place
[app-name=ray-osd]
anchor=top-center
width=280
height=70
default-timeout=1200
progress-color=over @accent@ff

# Super+Ctrl+, toggles this mode: nothing pops up until you turn it off
[mode=do-not-disturb]
invisible=1
