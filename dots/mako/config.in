# generated by `ray theme` — edit themes/*/palette instead
font=JetBrains Mono 10

background-color=@bg2@f2
text-color=@fg@
border-color=@accent@
progress-color=over @bg3@ff

anchor=top-right
margin=10
padding=10
border-size=2
border-radius=8
width=380
height=140
max-visible=4
default-timeout=6000
ignore-timeout=0
layer=overlay
