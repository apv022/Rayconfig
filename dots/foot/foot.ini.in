# generated by `ray theme` — edit themes/*/palette instead
[main]
font=JetBrains Mono:size=11
pad=10x10
dpi-aware=yes
term=foot
# leave a little transparency so solarvim's winblend shows the wallpaper
alpha=0.96
selection-target=clipboard
osc52=copy

[scrollback]
lines=10000

[cursor]
blink=yes

[colors]
background=@bg@
foreground=@fg@

regular0=@bg2@
regular1=@red@
regular2=@green@
regular3=@amber@
regular4=@blue@
regular5=@purple@
regular6=@teal@
regular7=@fg@

bright0=@bg3@
bright1=@red@
bright2=@green@
bright3=@sun@
bright4=@blue@
bright5=@purple@
bright6=@teal@
bright7=@fg@

cursor=@sun@ @bg@
selection-foreground=@bg@
selection-background=@sun@
urls=@blue@
