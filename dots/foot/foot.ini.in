# generated by `ray theme` — edit themes/*/palette instead
# foot >= 1.26: colors live in [colors-dark]/[colors-light], alpha moves there
# too, and osc52 lives in [security]. Values are RRGGBB with no leading '#'.
[main]
font=@font@:size=11
pad=10x10
dpi-aware=yes
term=foot
selection-target=clipboard
initial-color-theme=@variant@

[security]
osc52=copy-enabled

[scrollback]
lines=10000

[cursor]
blink=yes

@colors_section@
# leave a little transparency so solarvim's winblend shows the wallpaper
alpha=0.96
background=@bg_hex@
foreground=@fg_hex@

regular0=@bg2_hex@
regular1=@red_hex@
regular2=@green_hex@
regular3=@amber_hex@
regular4=@blue_hex@
regular5=@purple_hex@
regular6=@teal_hex@
regular7=@fg_hex@

bright0=@bg3_hex@
bright1=@red_hex@
bright2=@green_hex@
bright3=@sun_hex@
bright4=@blue_hex@
bright5=@purple_hex@
bright6=@teal_hex@
bright7=@fg_hex@

cursor=@sun_hex@ @bg_hex@
selection-foreground=@bg_hex@
selection-background=@sun_hex@
urls=@blue_hex@
