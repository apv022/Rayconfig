# generated by `ray theme` — edit themes/*/palette instead
# fuzzel takes rrggbbaa, no leading '#'
[main]
font=JetBrains Mono:size=11
prompt="  "
terminal=foot
layer=overlay
width=44
lines=10
horizontal-pad=12
vertical-pad=10
inner-pad=6
match-mode=fzf

[colors]
background=@bg2_hex@f2
text=@fg_hex@ff
prompt=@sun_hex@ff
placeholder=@dim_hex@ff
input=@fg_hex@ff
match=@accent_hex@ff
selection=@bg3_hex@ff
selection-text=@fg_hex@ff
selection-match=@sun_hex@ff
border=@accent_hex@ff
